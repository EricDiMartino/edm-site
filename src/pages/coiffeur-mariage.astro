---
import Layout from '../components/Layout.astro';
import PrestationPage from '../components/PrestationPage.astro';
import { mariage as data } from '../data/prestation-mariage';
import { buildPrestationSchemas } from '../lib/prestations-shared';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const NOM = 'Coiffure de mariage';
const { service, breadcrumb, faqSchema } = buildPrestationSchemas(data, canonical, NOM, Astro.site);
---

<Layout title={data.seo.title} description={data.seo.description} canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(service)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} slot="head" />
  <PrestationPage data={data} />
</Layout>
