---
// Page consultation NORMALE (avec nav, reliée depuis Prestations, indexable).
// Réservation via iframe + SÉLECTEUR DE SALON (un widget par salon).
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import { consultation as c } from '../data/consultation';
import { grenoble } from '../data/grenoble';
import { montbonnot } from '../data/montbonnot';
import { voiron } from '../data/voiron';
import { aixLesBains } from '../data/aix-les-bains';
import { salonsNav, areaServed } from '../lib/prestations-shared';
import { buildBreadcrumb } from '../lib/schema';
import SiteFooter from '../components/SiteFooter.astro';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const SALONS = [
  { ...grenoble, href: '/salon-de-coiffure/grenoble' },
  { ...montbonnot, href: '/salon-de-coiffure/montbonnot' },
  { ...voiron, href: '/salon-de-coiffure/voiron' },
  { ...aixLesBains, href: '/salon-de-coiffure/aix-les-bains' },
];
// Ensemble « consultation » Planity par salon (serviceSetsWhitelist) → widget filtré sur la seule consultation.
// ⚠️ ids Firebase stables mais opaques ; si un ensemble consultation est supprimé/recréé dans Planity, mettre à jour ici.
const CONSULT_CAT: Record<string, string> = {
  '-M2E_c9IB-StXRRzP_6T': '-Npsyr8_adZCPf_f2Ouv', // Grenoble — « Femme - Consultation »
  '-MkDNk8IahEaZLYEklvg': '-Nmz2hwTLuts3wrxdWzE', // Montbonnot — « Consultation visagiste »
  '-L7OgePoi82iJeECJYDN': '-N6DIYriYrERC0i9g58A', // Voiron — « Rendez-vous consultation »
  '-Mb6Bi_k1N3O517DT9yI': '-NUXrm6GydGUs65GxhFK', // Aix-les-Bains — « Rendez-vous consultation »
};
const offre = c.offre;

const providers = SALONS.map((s) => ({
  '@type': 'HairSalon',
  name: `Eric Di Martino — ${s.ville}`,
  telephone: s.telephone,
  address: { '@type': 'PostalAddress', streetAddress: s.adresse, postalCode: s.codePostal, addressLocality: s.ville, addressCountry: 'FR' },
}));
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Consultation visagiste',
  name: 'Consultation visagiste & coloriste',
  description: c.seo.description,
  url: canonical,
  areaServed,
  provider: providers,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.reponse } })),
};
const breadcrumb = buildBreadcrumb([{ name: 'Accueil', item: new URL('/', Astro.site).href }, { name: 'Prestations', item: new URL('/prestations-coiffure', Astro.site).href }, { name: 'Consultation visagiste', item: canonical }]);
---

<Layout title="Consultation visagiste & coloriste | Eric Di Martino" description={c.seo.description} canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(service)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} slot="head" />

  <Header salons={salonsNav} current="prestations" />

  <main>
    <!-- HERO -->
    <section class="section cv-hero">
      <div class="reveal">
        <p class="label">{c.hero.eyebrow}</p>
        {offre.actif && <p class="cv-badge">{offre.quantite} consultations offertes · jusqu’au {offre.date}</p>}
        <h1 class="editorial cv-h1">{c.hero.titre} <em class="ital">{c.hero.titreEm}</em></h1>
        <p class="lede cv-lede">{c.hero.lede}</p>
        <div class="cv-actions">
          <a class="btn btn-action" href="#reserver">Réserver ma consultation</a>
          <a class="btn btn-ghost" href="/prestations-coiffure">Toutes les prestations</a>
        </div>
      </div>
    </section>

    <!-- INCLUS -->
    <section class="section cv-inclus">
      <header class="section-head reveal">
        <p class="label">Inclus</p>
        <h2 class="h-seo">{c.inclus.titre}</h2>
        <p class="cv-duree">{c.inclus.duree}</p>
      </header>
      <ul class="cv-inclus-grid reveal" data-d="1">
        {c.inclus.items.map((i) => (<li class="cv-inclus-item"><h3>{i.titre}</h3><p>{i.texte}</p></li>))}
      </ul>
    </section>

    <!-- C'EST POUR VOUS SI -->
    <section class="section cv-besoins">
      <header class="section-head reveal">
        <p class="label">Pour qui</p>
        <h2 class="h-seo">{c.besoins.titre}</h2>
      </header>
      <ul class="cv-besoins-grid reveal" data-d="1">
        {c.besoins.items.map((b) => (<li class="cv-besoin"><h3>{b.titre}</h3><p>{b.texte}</p></li>))}
      </ul>
    </section>

    <!-- RÉSERVATION — sélecteur de salon + iframe -->
    <section class="section cv-resa" id="reserver">
      <header class="section-head reveal">
        <p class="label">Réserver</p>
        <h2 class="h-seo">Réservez votre consultation visagiste près de chez vous</h2>
        <p class="lede cv-resa-lede">Choisissez votre salon de coiffure, Grenoble, Montbonnot, Voiron ou Aix-les-Bains : vous réservez votre consultation visagiste et coloriste directement auprès de l’équipe qui vous recevra.</p>
      </header>
      <div class="cv-tabs reveal" role="tablist">
        {SALONS.map((s, i) => (
          <button type="button" class="cv-tab" data-key={s.planityKey} data-cat={CONSULT_CAT[s.planityKey ?? ''] ?? ''} aria-selected={i === 0 ? 'true' : 'false'}>{s.ville}</button>
        ))}
      </div>
      <div class="cv-stage reveal" data-d="1">
        <iframe id="cv-frame" title="Réservation en ligne" loading="lazy"></iframe>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section cv-faq">
      <header class="section-head reveal">
        <p class="label">FAQ</p>
        <h2 class="h-seo">Bon à savoir</h2>
      </header>
      <div class="cv-faq-list reveal" data-d="1">
        {c.faq.map((f) => (
          <details class="faq-item">
            <summary>{f.question}<span class="faq-plus" aria-hidden="true"></span></summary>
            <div class="rt"><p>{f.reponse}</p></div>
          </details>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter sub="Salons de coiffure · Grenoble · Montbonnot · Voiron · Aix-les-Bains" />

  <script is:inline>
    (function () {
      var tabs = document.querySelectorAll('.cv-tab');
      var frame = document.getElementById('cv-frame');
      function select(tab) {
        tabs.forEach(function (t) { t.setAttribute('aria-selected', t === tab ? 'true' : 'false'); });
        var key = tab.getAttribute('data-key') || '';
        var cat = tab.getAttribute('data-cat') || '';
        if (key) {
          var url = '/reserver-widget?key=' + encodeURIComponent(key);
          if (cat) url += '&cat=' + encodeURIComponent(cat);
          frame.style.height = ''; // repli min-height pendant le chargement du nouveau salon
          frame.src = url;
        }
      }
      tabs.forEach(function (t) { t.addEventListener('click', function () { select(t); }); });
      if (tabs.length) select(tabs[0]);
      // L'iframe (même origine) remonte sa hauteur réelle → on adapte, plus de scroll interne.
      addEventListener('message', function (e) {
        if (e.data && e.data.type === 'edm-widget-height' && e.source === frame.contentWindow) {
          frame.style.height = e.data.height + 'px';
        }
      });
    })();
  </script>

  <style>
    .cv-h1 { max-width: 18ch; }
    .cv-h1 em { font-style: italic; color: var(--olive); }
    .cv-lede { max-width: 50ch; }
    .cv-badge { display: inline-block; font-family: var(--sans); font-weight: 600; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--terracotta); background: var(--cream); border: 1px solid var(--line); border-radius: 999px; padding: 0.4rem 0.9rem; margin: 0 0 1.1rem; }
    .cv-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.8rem; }

    .cv-duree { margin: 0.8rem 0 0; font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--olive); }
    .cv-inclus-grid { list-style: none; margin: clamp(1.5rem,4vw,2.5rem) 0 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: clamp(1rem,3vw,1.5rem); }
    .cv-inclus-item { background: var(--cream); border-radius: var(--radius); padding: clamp(1.3rem,3vw,1.7rem); }
    .cv-inclus-item h3 { font-family: var(--serif); font-weight: 400; font-size: 1.2rem; margin: 0 0 0.4rem; }
    .cv-inclus-item p { color: var(--muted); font-size: 0.92rem; line-height: 1.55; margin: 0; }

    .cv-besoins-grid { list-style: none; margin: clamp(1.5rem,4vw,2.5rem) 0 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: clamp(1rem,3vw,1.5rem); }
    .cv-besoin { border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(1.3rem,3vw,1.7rem); }
    .cv-besoin h3 { font-family: var(--serif); font-weight: 400; font-size: 1.2rem; margin: 0 0 0.4rem; }
    .cv-besoin p { color: var(--muted); font-size: 0.92rem; line-height: 1.55; margin: 0; }

    /* Réservation */
    .cv-resa-lede { max-width: 52ch; }
    .cv-tabs { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: clamp(1.5rem,4vw,2.25rem) 0 1.25rem; }
    .cv-tab { font-family: var(--sans); font-weight: 500; font-size: 0.9rem; letter-spacing: 0.02em; color: var(--ink); background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 0.6rem 1.3rem; cursor: pointer; transition: background-color 0.25s, color 0.25s, border-color 0.25s; }
    .cv-tab:hover { border-color: var(--olive); color: var(--olive); }
    .cv-tab[aria-selected="true"] { background: var(--ink); color: #fff; border-color: var(--ink); }
    .cv-stage { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--cream); }
    #cv-frame { width: 100%; min-height: 360px; border: 0; display: block; }

    /* FAQ */
    .cv-faq-list { border-top: 1px solid var(--line); max-width: 820px; }


    @media (min-width: 640px) {
      .cv-inclus-grid { grid-template-columns: repeat(2, 1fr); }
      .cv-besoins-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (min-width: 1000px) {
      .cv-inclus-grid { grid-template-columns: repeat(4, 1fr); }
    }
  </style>
</Layout>
