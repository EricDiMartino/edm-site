---
// Page HEAD SPA Grenoble — design SOMBRE. Layout + Header du système, contenu en dur.
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import { headSpa as h } from '../data/head-spa';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const telHref = 'tel:' + h.telephone.replace(/[^0-9+]/g, '');
const cpVille = `${h.lieu.codePostal} ${h.ville}`;

// Icônes filaires (trait cuivre) pour la grille bienfaits.
const ICONS: Record<string, string> = {
  leaf: '<path d="M5 19c0-8 6-14 14-14 0 8-6 14-14 14z"/><path d="M5 19c4-4 7-7 11-9"/>',
  moon: '<path d="M20 14.5A8 8 0 1 1 9.5 4 6.5 6.5 0 0 0 20 14.5z"/>',
  drop: '<path d="M12 3s6 6 6 11a6 6 0 0 1-12 0c0-5 6-11 6-11z"/>',
  wave: '<path d="M3 12h4l2-5 4 10 2-5h6"/>',
  sparkle: '<path d="M12 3l1.9 5.6L20 10l-6.1 1.4L12 17l-1.9-5.6L4 10l6.1-1.4z"/>',
  mind: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/>',
};

// Schémas SEO/GEO
const provider = {
  '@type': 'HairSalon',
  name: `Eric Di Martino — ${h.ville}`,
  telephone: h.telephone,
  address: { '@type': 'PostalAddress', streetAddress: h.lieu.adresse, postalCode: h.lieu.codePostal, addressLocality: h.ville, addressCountry: 'FR' },
  sameAs: [h.instagram.url],
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Head Spa',
  name: 'Head Spa japonais',
  description: h.seo.description,
  url: canonical,
  areaServed: h.ville,
  provider,
  offers: h.tarifs.formules.map((f) => ({ '@type': 'Offer', name: f.nom, price: f.prix, priceCurrency: 'EUR', url: canonical })),
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: h.faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.reponse } })),
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Head spa', item: canonical },
  ],
};

// Panneau hero : infos pratiques remontées (durée, prix, adresse, horaires + tél en plus).
const jourCourt: Record<string, string> = { 'Mardi – Vendredi': 'Mar–Ven', 'Samedi': 'Sam', 'Dimanche & Lundi': 'Dim & Lun' };
const heroHoraires = h.lieu.horaires
  .filter((x) => !x.ferme)
  .map((x) => `${jourCourt[x.jour] ?? x.jour} ${x.valeur.replace(/ /g, '')}`)
  .join(' · ');
const heroMeta = [
  { label: 'Adresse', valeur: `${h.lieu.adresse}, ${h.ville}` },
  { label: 'Horaires', valeur: heroHoraires },
];
// Carte Google (même embed que les pages salon).
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent([h.lieu.adresse, h.lieu.codePostal, h.ville].filter(Boolean).join(', '))}&z=16&output=embed`;
---

<Layout title={h.seo.title} description={h.seo.description} canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} slot="head" />

  <Header tel={h.telephone} reservationUrl={h.reservationUrl} current="headspa" />

  <div class="headspa">
    <!-- HERO -->
    <section class="hs-hero">
      <div class="hs-hero-inner">
        <div class="hs-hero-copy reveal">
          <p class="hs-eyebrow">{h.hero.eyebrow}</p>
          <h1 class="hs-display">{h.hero.titre}<br /><em>{h.hero.titreEm}</em></h1>
          <p class="hs-lede">{h.hero.lede}</p>
          <div class="hs-actions">
            <a class="btn btn-action btn-lg" href={h.reservationUrl}>Réserver mon rituel</a>
            <a class="btn hs-ghost btn-video" href="#rituel">
              <svg class="play-ico" width="11" height="11" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
              Découvrir le rituel
            </a>
          </div>
        </div>
        <div class="hs-hero-side reveal" data-d="1">
          <ul class="hs-meta">
            {heroMeta.map((m) => (
              <li><span class="hs-meta-label">{m.label}</span><span class="hs-meta-val">{m.valeur}</span></li>
            ))}
            <li><span class="hs-meta-label">Téléphone</span><a class="hs-meta-val hs-meta-tel" href={telHref}>{h.telephone}</a></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- I — LE RITUEL -->
    <section class="hs-sec" id="rituel">
      <header class="hs-sec-head reveal">
        <p class="hs-eyebrow">{h.intro.eyebrow}</p>
        <h2 class="hs-h2">{h.intro.titre}</h2>
      </header>
      <div class="hs-intro-grid">
        <div class="hs-prose reveal">
          {h.intro.paragraphes.map((p) => <p>{p}</p>)}
        </div>
        <blockquote class="hs-quote reveal" data-d="1">
          <p>{h.intro.citation.texte}</p>
          <cite>{h.intro.citation.auteur}</cite>
        </blockquote>
      </div>
    </section>

    <!-- II — LE DÉROULÉ -->
    <section class="hs-sec hs-band">
      <header class="hs-sec-head reveal">
        <p class="hs-eyebrow">{h.deroule.eyebrow}</p>
        <h2 class="hs-h2">{h.deroule.titre}</h2>
        <p class="hs-sec-intro">{h.deroule.intro}</p>
      </header>
      <ol class="hs-steps">
        {h.deroule.etapes.map((e) => (
          <li class="hs-step reveal">
            <input type="checkbox" id={`hs-step-${e.num}`} class="hs-step-toggle" />
            <label class="hs-step-head" for={`hs-step-${e.num}`}>
              <span class="hs-step-num">{e.num}</span>
              <span class="hs-step-title">{e.titre}</span>
              <span class="hs-step-chev" aria-hidden="true"></span>
            </label>
            <p class="hs-step-text">{e.texte}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- LES BIENFAITS -->
    <section class="hs-sec">
      <header class="hs-sec-head hs-center reveal">
        <p class="hs-eyebrow">{h.bienfaits.eyebrow}</p>
        <h2 class="hs-h2">{h.bienfaits.titre}</h2>
        <p class="hs-sec-intro">{h.bienfaits.intro}</p>
      </header>
      <div class="hs-benefits reveal" data-d="1">
        {h.bienfaits.items.map((b) => (
          <article class="hs-benefit">
            <svg class="hs-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[b.icon] ?? ICONS.leaf} />
            <h3>{b.titre}</h3>
            <p>{b.texte}</p>
            <span class="hs-benefit-div" aria-hidden="true"></span>
            <span class="hs-benefit-cap">{b.caption}</span>
          </article>
        ))}
      </div>
    </section>

    <!-- III — TARIFS -->
    <section class="hs-sec hs-band" id="tarifs">
      <header class="hs-sec-head hs-center reveal">
        <p class="hs-eyebrow">{h.tarifs.eyebrow}</p>
        <h2 class="hs-h2">{h.tarifs.titre}</h2>
        <p class="hs-sec-intro">{h.tarifs.intro}</p>
      </header>
      <div class="hs-plans reveal" data-d="1">
        {h.tarifs.formules.map((f) => (
          <article class={`hs-plan ${f.highlight ? 'is-feat' : ''}`}>
            {f.badge && <span class="hs-plan-badge">{f.badge}</span>}
            <h3 class="hs-plan-name">{f.nom}</h3>
            <p class="hs-plan-price"><span class="hs-plan-amount">{f.prix}</span><span class="hs-plan-cur">€</span><span class="hs-plan-duree">· {f.duree}</span></p>
            <ul class="hs-plan-points">
              {f.points.map((p) => <li>{p}</li>)}
            </ul>
            <a class={`btn ${f.highlight ? 'btn-action' : 'hs-ghost'}`} href={h.reservationUrl}>Réserver</a>
          </article>
        ))}
      </div>
      {h.tarifs.extras && (
        <div class="hs-extras-wrap reveal">
          <ul class="hs-extras">
            {h.tarifs.extras.map((e) => (
              <li><span class="hs-extra-name">{e.nom}</span><span class="hs-extra-detail">{e.detail}</span><span class="hs-extra-price">{e.prix}</span></li>
            ))}
          </ul>
          <p class="hs-extras-note">Duo et cures sur réservation téléphonique — <a href={telHref}>{h.telephone}</a>.</p>
        </div>
      )}
    </section>

    <!-- L'ATMOSPHÈRE -->
    <section class="hs-sec">
      <header class="hs-sec-head reveal">
        <p class="hs-eyebrow">{h.atmosphere.eyebrow}</p>
        <h2 class="hs-h2">{h.atmosphere.titre}</h2>
      </header>
      <div class="hs-gallery reveal" data-d="1">
        {h.atmosphere.photos.map((label, i) => (
          <figure class={`hs-shot hs-shot-${i}`}><figcaption>{label}</figcaption></figure>
        ))}
      </div>
    </section>

    <!-- LIEU -->
    <section class="hs-sec hs-band">
      <div class="hs-place">
        <div class="hs-place-visual reveal">
          <iframe title="Carte — Salon Grenoble" src={mapEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="hs-place-copy reveal" data-d="1">
          <p class="hs-eyebrow">{h.lieu.eyebrow}</p>
          <h2 class="hs-h2">{h.lieu.titre}</h2>
          <p class="hs-place-name">{h.lieu.nom}</p>
          <p class="hs-place-addr">{h.lieu.adresse}<br />{cpVille}</p>
          <ul class="hs-hours">
            {h.lieu.horaires.map((hr) => (
              <li class={hr.ferme ? 'is-closed' : ''}><span>{hr.jour}</span><span>{hr.valeur}</span></li>
            ))}
          </ul>
          <div class="hs-place-links">
            <a class="hs-link" href={h.salonHref}>Découvrir le salon →</a>
            <a class="hs-link" href={h.mapsUrl}>Itinéraire ›</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="hs-sec">
      <header class="hs-sec-head reveal">
        <p class="hs-eyebrow">Questions fréquentes</p>
        <h2 class="hs-h2">Avant de réserver</h2>
      </header>
      <div class="hs-faq reveal" data-d="1">
        {h.faq.map((f) => (
          <details class="hs-faq-item">
            <summary>{f.question}<span class="hs-plus" aria-hidden="true"></span></summary>
            <p>{f.reponse}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- INSTAGRAM -->
    <section class="hs-sec hs-band">
      <header class="hs-sec-head hs-center reveal">
        <p class="hs-eyebrow">{h.instagram.eyebrow}</p>
        <h2 class="hs-h2">{h.instagram.titre}</h2>
        <p class="hs-sec-intro">{h.instagram.texte}</p>
      </header>
      <div class="hs-ig reveal" data-d="1">
        {Array.from({ length: 6 }).map(() => (
          <a class="hs-ig-shot" href={h.instagram.url} target="_blank" rel="noopener" aria-label={`Voir ${h.instagram.handle} sur Instagram`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" /></svg>
          </a>
        ))}
      </div>
      <p class="hs-ig-follow reveal"><a class="hs-link" href={h.instagram.url} target="_blank" rel="noopener">Suivre {h.instagram.handle} →</a></p>
    </section>

    <!-- CTA -->
    <section class="hs-cta" id="reserver">
      <div class="reveal">
        <p class="hs-eyebrow">{h.cta.eyebrow}</p>
        <p class="hs-cta-title">{h.cta.titre}</p>
        <p class="hs-cta-text">{h.cta.texte}</p>
        <a class="btn btn-action btn-lg" href={h.reservationUrl}>Réserver en ligne</a>
        <p class="hs-cta-tel">ou par téléphone — <a href={telHref}>{h.telephone}</a></p>
      </div>
    </section>

    <footer class="hs-footer">
      <p class="hs-foot-mark">Eric Di Martino</p>
      <p class="hs-foot-sub">Head Spa japonais · Salon de Grenoble · {h.lieu.adresse}, {cpVille}</p>
    </footer>
  </div>

  <style is:global>
    /* ====== HEAD SPA — thème sombre (scopé .headspa) ====== */
    .headspa {
      --hs-ink: #1d1813;
      --hs-band: #241d17;
      --hs-copper: #cf9d72;
      --hs-cream: rgba(247, 243, 234, 0.9);
      --hs-muted: rgba(247, 243, 234, 0.55);
      --hs-line: rgba(247, 243, 234, 0.13);
      background: var(--hs-ink);
      color: var(--hs-cream);
    }
    .headspa em { font-style: italic; }
    .hs-eyebrow {
      display: inline-flex; align-items: center; gap: 0.75rem;
      font-family: var(--sans); font-weight: 600; font-size: 0.7rem;
      letter-spacing: 0.26em; text-transform: uppercase; color: var(--hs-copper); margin: 0 0 1.1rem;
    }
    .hs-eyebrow::before { content: ""; width: 1.7rem; height: 1px; background: currentColor; opacity: 0.6; }
    .hs-h2 {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.6rem); line-height: 1.12; letter-spacing: -0.01em;
      color: #fdfbf7; margin: 0; max-width: 22ch;
    }
    .hs-sec { max-width: var(--maxw); margin-inline: auto; padding: clamp(3.5rem, 8vw, 6.5rem) var(--gutter); }
    .hs-band { max-width: none; background: var(--hs-band); }
    .hs-band > * { max-width: var(--maxw); margin-inline: auto; }
    .hs-sec-head { margin-bottom: clamp(2rem, 5vw, 3.25rem); }
    .hs-center { text-align: center; }
    .hs-center .hs-eyebrow, .hs-center .hs-h2 { margin-inline: auto; }
    .hs-center .hs-eyebrow::after { content: ""; width: 1.7rem; height: 1px; background: currentColor; opacity: 0.6; }
    .hs-sec-intro { color: var(--hs-muted); max-width: 56ch; margin: 1.1rem 0 0; }
    .hs-center .hs-sec-intro { margin-inline: auto; }

    /* HERO */
    .hs-hero {
      position: relative; overflow: hidden;
      min-height: calc(100svh - var(--header-h));
      display: flex; align-items: center;
      padding: clamp(3rem, 8vw, 5.5rem) var(--gutter);
      background:
        radial-gradient(120% 80% at 75% 18%, rgba(207, 157, 114, 0.18), transparent 55%),
        linear-gradient(160deg, #2a2119 0%, #1d1813 55%, #161109 100%);
    }
    .hs-hero-inner { width: 100%; max-width: var(--maxw); margin-inline: auto; display: grid; gap: clamp(2rem, 5vw, 3.5rem); }
    .hs-display {
      font-family: var(--serif); font-weight: 330; font-optical-sizing: auto;
      font-size: clamp(3rem, 1.8rem + 6vw, 6rem); line-height: 0.98; letter-spacing: -0.02em;
      color: #fdfbf7; margin: 0 0 1.3rem;
    }
    .hs-display em { color: var(--hs-copper); font-weight: 320; }
    .hs-lede { font-size: clamp(1.05rem, 1rem + 0.5vw, 1.2rem); line-height: 1.6; color: var(--hs-cream); max-width: 46ch; margin: 0; font-weight: 300; }
    .hs-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.9rem; }
    .hs-ghost { background: transparent; color: #fdfbf7; border: 1px solid var(--hs-line); }
    .hs-ghost:hover { border-color: var(--hs-copper); color: var(--hs-copper); }
    .hs-meta { display: grid; gap: 0; border-top: 1px solid var(--hs-line); }
    .hs-meta li { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 0.95rem 0; border-bottom: 1px solid var(--hs-line); }
    .hs-meta-label { font-family: var(--sans); font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--hs-muted); flex: none; }
    .hs-meta-val { font-family: var(--serif); font-size: 1.1rem; color: #fdfbf7; text-align: right; line-height: 1.3; }
    .hs-meta-tel { text-decoration: none; transition: color 0.3s; }
    .hs-meta-tel:hover { color: var(--hs-copper); }
    .hs-hero-side { display: flex; flex-direction: column; gap: clamp(1.75rem, 4vw, 2.5rem); }

    /* I — citation (à gauche) + prose */
    .hs-intro-grid { display: grid; gap: clamp(2rem, 5vw, 3.5rem); align-items: center; }
    .hs-prose { max-width: 60ch; }
    .hs-prose p { margin: 0 0 1.1rem; color: var(--hs-cream); }
    .hs-prose p:last-child { margin-bottom: 0; }
    .hs-quote { margin: 0; padding-left: clamp(1rem, 3vw, 2rem); border-left: 2px solid var(--hs-copper); max-width: 36ch; }
    .hs-quote p { font-family: var(--serif); font-style: italic; font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem); line-height: 1.25; color: #fdfbf7; margin: 0; }
    .hs-quote cite { display: block; margin-top: 1rem; font-family: var(--sans); font-style: normal; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--hs-copper); }

    /* II — étapes (mobile : repliables ; desktop : tout visible) */
    .hs-steps { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--hs-line); }
    .hs-step { padding: clamp(0.9rem, 3vw, 1.3rem) 0; border-bottom: 1px solid var(--hs-line); }
    .hs-step-toggle { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
    .hs-step-head { display: flex; align-items: baseline; gap: 0.85rem; cursor: pointer; }
    .hs-step-num { font-family: var(--serif); font-size: 1.3rem; color: var(--hs-copper); line-height: 1.2; flex: none; }
    .hs-step-title { font-family: var(--serif); font-weight: 400; font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem); color: #fdfbf7; flex: 1; }
    .hs-step-chev { flex: none; width: 0; height: 0; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid var(--hs-copper); transition: transform 0.3s var(--ease); align-self: center; }
    .hs-step-toggle:checked ~ .hs-step-head .hs-step-chev { transform: rotate(180deg); }
    .hs-step-text { margin: 0; max-height: 0; overflow: hidden; opacity: 0; color: var(--hs-muted); font-size: 0.92rem; line-height: 1.55; padding-left: 2.15rem; transition: max-height 0.4s var(--ease), opacity 0.3s, margin 0.4s; }
    .hs-step-toggle:checked ~ .hs-step-text { max-height: 18rem; opacity: 1; margin-top: 0.6rem; }

    /* Bienfaits */
    .hs-benefits { display: grid; grid-template-columns: 1fr; border-top: 1px solid var(--hs-line); }
    .hs-benefit { padding: clamp(1.75rem, 4vw, 2.5rem) 0; border-bottom: 1px solid var(--hs-line); }
    .hs-ico { width: 28px; height: 28px; color: var(--hs-copper); margin-bottom: clamp(1rem, 3vw, 1.6rem); }
    .hs-benefit h3 { font-family: var(--serif); font-weight: 400; font-size: 1.35rem; color: #fdfbf7; margin: 0 0 0.7rem; }
    .hs-benefit p { margin: 0; color: var(--hs-muted); font-size: 0.95rem; line-height: 1.6; max-width: 34ch; }
    .hs-benefit-div { display: block; height: 1px; background: var(--hs-line); margin: 1.4rem 0 0.9rem; }
    .hs-benefit-cap { font-family: var(--sans); font-weight: 500; font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--hs-muted); }

    /* Tarifs */
    .hs-plans { display: grid; gap: clamp(1rem, 3vw, 1.5rem); }
    .hs-plan { position: relative; display: flex; flex-direction: column; background: rgba(247, 243, 234, 0.03); border: 1px solid var(--hs-line); border-radius: var(--radius); padding: clamp(1.75rem, 4vw, 2.4rem); }
    .hs-plan.is-feat { border-color: var(--hs-copper); background: rgba(207, 157, 114, 0.07); }
    .hs-plan-badge { align-self: flex-start; font-family: var(--sans); font-size: 0.6rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--hs-copper); border: 1px solid var(--hs-line); border-radius: 999px; padding: 0.32rem 0.8rem; margin-bottom: 1.4rem; }
    .hs-plan.is-feat .hs-plan-badge { background: var(--hs-copper); color: #1d1813; border-color: var(--hs-copper); }
    .hs-plan-name { font-family: var(--serif); font-weight: 400; font-size: 1.6rem; color: #fdfbf7; margin: 0 0 0.6rem; }
    .hs-plan-price { display: flex; align-items: baseline; gap: 0.35rem; margin: 0 0 1.5rem; }
    .hs-plan-amount { font-family: var(--serif); font-size: 2.6rem; line-height: 1; color: #fdfbf7; }
    .hs-plan-cur { font-family: var(--serif); font-size: 1.2rem; color: var(--hs-copper); }
    .hs-plan-duree { font-size: 0.8rem; color: var(--hs-muted); margin-left: 0.3rem; }
    .hs-plan-points { list-style: none; margin: 0 0 1.9rem; padding: 0; display: grid; gap: 0.7rem; }
    .hs-plan-points li { position: relative; padding-left: 1.5rem; font-size: 0.92rem; color: var(--hs-cream); }
    .hs-plan-points li::before { content: ""; position: absolute; left: 0; top: 0.55em; width: 7px; height: 7px; border-left: 1px solid var(--hs-copper); border-bottom: 1px solid var(--hs-copper); transform: rotate(-45deg) translateY(-2px); }
    .hs-plan .btn { margin-top: auto; }
    .hs-extras-wrap { max-width: 46rem; margin: clamp(1.75rem, 4vw, 2.5rem) auto 0; }
