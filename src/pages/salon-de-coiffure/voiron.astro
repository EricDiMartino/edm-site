---
// Page salon Voiron — Layout commun + données en dur + avis Google (build).
import Layout from '../../components/Layout.astro';
import SalonPage from '../../components/SalonPage.astro';
import { voiron } from '../../data/voiron';
import { getGoogleReviews } from '../../lib/places';

const { seo } = voiron;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(voiron.heroImage.src, Astro.site).href;

// Avis Google récupérés au build ; repli placeholder si clé absente.
const liveAvis = await getGoogleReviews(voiron.googlePlaceId);
const chiffres = liveAvis
  ? voiron.chiffres?.map((c) =>
      /avis/i.test(c.label) ? { valeur: `${liveAvis.note}★`, label: `${liveAvis.total} avis Google` } : c,
    )
  : voiron.chiffres;
const salon = liveAvis
  ? {
      ...voiron,
      chiffres,
      avis: { note: liveAvis.note, total: liveAvis.total, source: liveAvis.source, url: liveAvis.url, items: liveAvis.items },
    }
  : voiron;

// Schema HairSalon (SEO local + GEO). aggregateRating uniquement depuis les vrais avis.
const hairSalon = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: `${voiron.nom} — ${voiron.ville}`,
  url: canonical,
  image: ogImage,
  telephone: voiron.telephone,
  priceRange: voiron.priceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: voiron.adresse,
    postalCode: voiron.codePostal,
    addressLocality: voiron.ville,
    addressCountry: 'FR',
  },
  ...(voiron.geo && {
    geo: { '@type': 'GeoCoordinates', latitude: voiron.geo.lat, longitude: voiron.geo.lng },
  }),
  ...(liveAvis && {
    aggregateRating: { '@type': 'AggregateRating', ratingValue: liveAvis.noteRaw, reviewCount: liveAvis.total },
  }),
  areaServed: voiron.areaServed,
  ...(voiron.instagram && { sameAs: [voiron.instagram.url] }),
  openingHoursSpecification: voiron.horaires
    .filter((h) => h.opens && h.closes && h.jourEn)
    .map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: `https://schema.org/${h.jourEn}`,
      opens: h.opens,
      closes: h.closes,
    })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Salons', item: new URL('/nos-salons-de-coiffure', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: voiron.ville, item: canonical },
  ],
};
---

<Layout title={seo.title} description={seo.description} canonical={canonical} ogImage={ogImage}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(hairSalon)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} slot="head" />
  <SalonPage salon={salon} />
</Layout>
