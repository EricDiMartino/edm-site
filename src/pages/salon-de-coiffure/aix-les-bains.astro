---
// Page salon Aix-les-Bains — Layout commun + données en dur + avis Google (build).
import Layout from '../../components/Layout.astro';
import SalonPage from '../../components/SalonPage.astro';
import { aixLesBains } from '../../data/aix-les-bains';
import { getGoogleReviews } from '../../lib/places';

const { seo } = aixLesBains;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(aixLesBains.heroImage.src, Astro.site).href;

// Avis Google récupérés au build ; repli placeholder si clé absente.
const liveAvis = await getGoogleReviews(aixLesBains.googlePlaceId);
const chiffres = liveAvis
  ? aixLesBains.chiffres?.map((c) =>
      /avis/i.test(c.label) ? { valeur: `${liveAvis.note}★`, label: `${liveAvis.total} avis Google` } : c,
    )
  : aixLesBains.chiffres;
const salon = liveAvis
  ? {
      ...aixLesBains,
      chiffres,
      avis: { note: liveAvis.note, total: liveAvis.total, source: liveAvis.source, url: liveAvis.url, items: liveAvis.items },
    }
  : aixLesBains;

// Schema HairSalon (SEO local + GEO). aggregateRating uniquement depuis les vrais avis.
const hairSalon = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: `${aixLesBains.nom} — ${aixLesBains.ville}`,
  url: canonical,
  image: ogImage,
  telephone: aixLesBains.telephone,
  priceRange: aixLesBains.priceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: aixLesBains.adresse,
    postalCode: aixLesBains.codePostal,
    addressLocality: aixLesBains.ville,
    addressCountry: 'FR',
  },
  ...(aixLesBains.geo && {
    geo: { '@type': 'GeoCoordinates', latitude: aixLesBains.geo.lat, longitude: aixLesBains.geo.lng },
  }),
  ...(liveAvis && {
    aggregateRating: { '@type': 'AggregateRating', ratingValue: liveAvis.noteRaw, reviewCount: liveAvis.total },
  }),
  areaServed: aixLesBains.areaServed,
  openingHoursSpecification: aixLesBains.horaires
    .filter((h) => h.opens && h.closes && h.jourEn)
    .map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: `https://schema.org/${h.jourEn}`,
      opens: h.opens,
      closes: h.closes,
    })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Salons', item: new URL('/nos-salons-de-coiffure', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: aixLesBains.ville, item: canonical },
  ],
};
---

<Layout title={seo.title} description={seo.description} canonical={canonical} ogImage={ogImage}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(hairSalon)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} slot="head" />
  <SalonPage salon={salon} />
</Layout>
