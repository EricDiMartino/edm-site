---
// Pages salon (Grenoble / Montbonnot / Voiron / Aix-les-Bains) — route dynamique.
// Layout commun + données en dur (src/data/*) + avis Google récupérés au build.
import Layout from '../../components/Layout.astro';
import SalonPage from '../../components/SalonPage.astro';
import { getGoogleReviews } from '../../lib/places';
import { grenoble } from '../../data/grenoble';
import { montbonnot } from '../../data/montbonnot';
import { voiron } from '../../data/voiron';
import { aixLesBains } from '../../data/aix-les-bains';

// Un chemin par salon ; le slug d'URL est conservé à l'identique.
export function getStaticPaths() {
  return [
    { params: { ville: 'grenoble' }, props: { data: grenoble } },
    { params: { ville: 'montbonnot' }, props: { data: montbonnot } },
    { params: { ville: 'voiron' }, props: { data: voiron } },
    { params: { ville: 'aix-les-bains' }, props: { data: aixLesBains } },
  ];
}

const { data } = Astro.props;
const { seo } = data;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(data.heroImage.src, Astro.site).href;

// Avis Google récupérés au build ; repli placeholder si clé absente.
const liveAvis = await getGoogleReviews(data.googlePlaceId);
const chiffres = liveAvis
  ? data.chiffres?.map((c) =>
      /avis/i.test(c.label) ? { valeur: `${liveAvis.note}★`, label: `${liveAvis.total} avis Google` } : c,
    )
  : data.chiffres;
const salon = liveAvis
  ? {
      ...data,
      chiffres,
      avis: { note: liveAvis.note, total: liveAvis.total, source: liveAvis.source, url: liveAvis.url, items: liveAvis.items },
    }
  : data;

// Schema HairSalon (SEO local + GEO). aggregateRating uniquement depuis les vrais avis.
const hairSalon = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: `${data.nom} — ${data.ville}`,
  url: canonical,
  image: ogImage,
  telephone: data.telephone,
  priceRange: data.priceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: data.adresse,
    postalCode: data.codePostal,
    addressLocality: data.ville,
    addressCountry: 'FR',
  },
  ...(data.geo && {
    geo: { '@type': 'GeoCoordinates', latitude: data.geo.lat, longitude: data.geo.lng },
  }),
  ...(liveAvis && {
    aggregateRating: { '@type': 'AggregateRating', ratingValue: liveAvis.noteRaw, reviewCount: liveAvis.total },
  }),
  areaServed: data.areaServed,
  ...(data.instagram && { sameAs: [data.instagram.url] }),
  openingHoursSpecification: data.horaires
    .filter((h) => h.opens && h.closes && h.jourEn)
    .map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: `https://schema.org/${h.jourEn}`,
      opens: h.opens,
      closes: h.closes,
    })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Salons', item: new URL('/nos-salons-de-coiffure', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: data.ville, item: canonical },
  ],
};
---

<Layout title={seo.title} description={seo.description} canonical={canonical} ogImage={ogImage}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(hairSalon)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} slot="head" />
  <SalonPage salon={salon} />
</Layout>
