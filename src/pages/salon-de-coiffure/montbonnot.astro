---
// Page salon Montbonnot — Layout commun + données en dur + avis Google (build).
import Layout from '../../components/Layout.astro';
import SalonPage from '../../components/SalonPage.astro';
import { montbonnot } from '../../data/montbonnot';
import { getGoogleReviews } from '../../lib/places';

const { seo } = montbonnot;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(montbonnot.heroImage.src, Astro.site).href;

// Avis Google récupérés au build ; repli placeholder si clé absente.
const liveAvis = await getGoogleReviews(montbonnot.googlePlaceId);
const chiffres = liveAvis
  ? montbonnot.chiffres?.map((c) =>
      /avis/i.test(c.label) ? { valeur: `${liveAvis.note}★`, label: `${liveAvis.total} avis Google` } : c,
    )
  : montbonnot.chiffres;
const salon = liveAvis
  ? {
      ...montbonnot,
      chiffres,
      avis: { note: liveAvis.note, total: liveAvis.total, source: liveAvis.source, url: liveAvis.url, items: liveAvis.items },
    }
  : montbonnot;

// Schema HairSalon (SEO local + GEO). aggregateRating uniquement depuis les vrais avis.
const hairSalon = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: `${montbonnot.nom} — ${montbonnot.ville}`,
  url: canonical,
  image: ogImage,
  telephone: montbonnot.telephone,
  priceRange: montbonnot.priceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: montbonnot.adresse,
    postalCode: montbonnot.codePostal,
    addressLocality: montbonnot.ville,
    addressCountry: 'FR',
  },
  ...(montbonnot.geo && {
    geo: { '@type': 'GeoCoordinates', latitude: montbonnot.geo.lat, longitude: montbonnot.geo.lng },
  }),
  ...(liveAvis && {
    aggregateRating: { '@type': 'AggregateRating', ratingValue: liveAvis.noteRaw, reviewCount: liveAvis.total },
  }),
  areaServed: montbonnot.areaServed,
  openingHoursSpecification: montbonnot.horaires
    .filter((h) => h.opens && h.closes && h.jourEn)
    .map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: `https://schema.org/${h.jourEn}`,
      opens: h.opens,
      closes: h.closes,
    })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Salons', item: new URL('/nos-salons-de-coiffure', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: montbonnot.ville, item: canonical },
  ],
};
---

<Layout title={seo.title} description={seo.description} canonical={canonical} ogImage={ogImage}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(hairSalon)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} slot="head" />
  <SalonPage salon={salon} />
</Layout>
