---
// Route dynamique de TOUS les salons — /salon-de-coiffure/{ville}.
// Une seule page pour Grenoble, Montbonnot, Voiron, Aix-les-Bains : chaque salon
// s'affiche dès que sa story existe dans Storyblok (content-type `salon`, sous
// salon-de-coiffure/), SANS nouveau code. Le design vit dans `Salon.astro`.
import { useStoryblokApi } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

export async function getStaticPaths() {
  const api = useStoryblokApi();
  const { data } = await api.get('cdn/stories', {
    version: 'draft',
    content_type: 'salon',
    starts_with: 'salon-de-coiffure/',
    per_page: 100,
  });
  return (data.stories ?? []).map((story) => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const blok = story.content;

// --- SEO depuis le bloc `seo` (max 1), avec replis propres si non rempli ---
const seo = Array.isArray(blok.seo) && blok.seo.length ? blok.seo[0] : {};
const t = (v) => (typeof v === 'string' ? v.trim() : '');
const seoTitle = t(seo.title) || t(blok.nom) || 'Salon de coiffure — Eric Di Martino';
const seoDesc = t(seo.meta_description) || t(blok.accroche);
const ogImage =
  (seo.og_image && seo.og_image.filename) ||
  (blok.hero_image && blok.hero_image.filename) ||
  '';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- noindex global jusqu'à la bascule (cf. vercel.json / Phase 6) -->
    <meta name="robots" content="noindex" />
    <title>{seoTitle}</title>
    {seoDesc && <meta name="description" content={seoDesc} />}
    <meta property="og:title" content={seoTitle} />
    {seoDesc && <meta property="og:description" content={seoDesc} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <StoryblokComponent blok={blok} />
  </body>
</html>
