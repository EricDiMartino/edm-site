---
// Styleguide INTERNE — reflète le vrai système (system.css via Layout). noindex.
import Layout from '../components/Layout.astro';

const marque = [
  { nom: 'Olive', hex: '#81806C', token: '--olive', usage: 'Marque : eyebrows, liens, bande CTA' },
  { nom: 'Terracotta', hex: '#C25510', token: '--terracotta', usage: 'Actions (boutons) — normal' },
  { nom: 'Brique', hex: '#B0392A', token: '--terracotta-deep', usage: 'Actions — survol' },
  { nom: 'Anthracite', hex: '#31302E', token: '--ink', usage: 'Texte & logo' },
  { nom: 'Crème', hex: '#F7F3EA', token: '--cream', usage: 'Fonds doux, cartes' },
  { nom: 'Blanc', hex: '#FFFFFF', token: '--bg', usage: 'Fond principal' },
  { nom: 'Espresso', hex: '#2A231D', token: '--espresso', usage: 'Moment sombre (head spa)' },
];
const semantiques = [
  { nom: 'Success', hex: '#6B7A4F', usage: 'Confirmation rendez-vous' },
  { nom: 'Warning', hex: '#B8862A', usage: 'Disponibilités limitées' },
  { nom: 'Error', hex: '#8B3A2E', usage: 'Champs invalides' },
  { nom: 'Info', hex: '#4A5C66', usage: 'Encadrés & tooltips' },
];
const espacements = [
  { token: '--maxw', val: '1200px', usage: 'Largeur max de section' },
  { token: '--gutter', val: 'clamp(1.25 → 4.5rem)', usage: 'Marge horizontale de section' },
  { token: '--section-y', val: 'clamp(4 → 7rem)', usage: 'Rythme vertical de section' },
  { token: '--radius', val: '2px', usage: 'Arrondi (boutons, cadres)' },
  { token: '--bp', val: '820px', usage: 'Breakpoint desktop (unique)' },
];
const patterns = [
  ['Header', 'eyebrow + titre (échelle h-seo). Nav fixe ; barre Appeler/Réserver en mobile.'],
  ['Split', 'image | texte alternés (.split, .split.reverse), centrés verticalement.'],
  ['Moment sombre', '.service-dark (head spa) — un seul par page, fond espresso.'],
  ['Cartes', 'équipe (portraits 3/4) · avis (carrousel scroll-snap, 5★).'],
  ['Bande CTA', '.cta olive — pleine largeur en mobile, contenue ≥820px.'],
  ['Motion', '.reveal au scroll (fade+translate), hover sur visuels/liens, respecte prefers-reduced-motion.'],
];
---

<Layout title="Styleguide — Eric Di Martino (interne)">
  <link slot="head" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <main class="sg">
    <header class="sg-head">
      <p class="mono tag">Styleguide interne · noindex</p>
      <h1>Système de design</h1>
      <p class="sg-intro">Source unique : <code>src/styles/system.css</code> (importé par <code>Layout.astro</code>). Titres : <strong>Fraunces</strong> (≈ HV&nbsp;Preston) · texte : <strong>Poppins</strong> (≈ Coco&nbsp;Gothic).</p>
    </header>

    <section class="sg-sec">
      <h2 class="mono sg-h">Couleurs · marque</h2>
      <div class="swatches">
        {marque.map((c) => (
          <article class="sw">
            <div class="sw-chip" style={`background:${c.hex}`}></div>
            <div class="sw-meta"><p class="sw-name">{c.nom}</p><p class="mono sw-hex">{c.hex}</p><p class="mono sw-token">{c.token}</p><p class="sw-usage">{c.usage}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="sg-sec">
      <h2 class="mono sg-h">Couleurs · sémantiques (formulaires)</h2>
      <div class="swatches">
        {semantiques.map((c) => (
          <article class="sw">
            <div class="sw-chip" style={`background:${c.hex}`}></div>
            <div class="sw-meta"><p class="sw-name">{c.nom}</p><p class="mono sw-hex">{c.hex}</p><p class="sw-usage">{c.usage}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="sg-sec">
      <h2 class="mono sg-h">Typographie</h2>
      <div class="trow"><span class="mono ttag">.editorial</span><p class="editorial">L'élégance, prise au mot.</p></div>
      <div class="trow"><span class="mono ttag">.h-seo (titre section)</span><h3 class="h-seo">Coiffeur &amp; coloriste visagiste à Grenoble</h3></div>
      <div class="trow"><span class="mono ttag">.label (eyebrow)</span><p class="label">Notre signature</p></div>
      <div class="trow"><span class="mono ttag">.lede</span><p class="lede">Une coiffure pensée pour vous, à partir d'une vraie consultation.</p></div>
      <div class="trow"><span class="mono ttag">.body</span><p class="body">Coupe pensée pour le visage, coloration sur-mesure, soins capillaires et head spa.</p></div>
    </section>

    <section class="sg-sec">
      <h2 class="mono sg-h">Boutons &amp; liens</h2>
      <div class="btns">
        <span class="btn btn-action">Réserver</span>
        <span class="btn btn-action" style="background:var(--terracotta-deep)">Réserver (survol)</span>
        <span class="btn btn-ghost">Découvrir le salon</span>
        <a class="link-olive link-arrow" href="#">Découvrir la consultation <span class="arrow">→</span></a>
      </div>
      <p class="mono note">Terracotta réservé aux actions. Survol = brique.</p>
    </section>

    <section class="sg-sec">
      <h2 class="mono sg-h">Espacements &amp; largeurs</h2>
      <table class="tok">
        <tbody>
          {espacements.map((e) => (
            <tr><td class="mono">{e.token}</td><td class="mono">{e.val}</td><td>{e.usage}</td></tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="sg-sec">
      <h2 class="mono sg-h">Patterns réutilisables</h2>
      <dl class="pat">
        {patterns.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
      </dl>
    </section>
  </main>

  <style>
    .sg { background: #ece8e1; min-height: 100vh; padding: clamp(1.5rem, 5vw, 4rem); margin: 0; }
    .sg :is(h1, h2, h3, p, dl, dd, dt, table) { margin: 0; }
    .mono { font-family: "IBM Plex Mono", monospace; }
    .tag { font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--olive); margin-bottom: 1rem; }
    .sg-head { max-width: 70rem; margin: 0 auto 3rem; }
    .sg-head h1 { font-family: var(--serif); font-weight: 380; font-size: clamp(1.8rem, 1.2rem + 2.4vw, 2.8rem); margin-bottom: 1rem; }
    .sg-intro { max-width: 56ch; color: #4a4940; }
    .sg-intro code { font-family: "IBM Plex Mono", monospace; font-size: 0.85em; background: #fff; padding: 0.1rem 0.35rem; border-radius: 2px; }
    .sg-sec { max-width: 70rem; margin: 0 auto 3.5rem; }
    .sg-h { font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--olive); border-top: 1px solid var(--line); padding-top: 1rem; margin-bottom: 1.5rem; }
    .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 1rem; }
    .sw { background: #fff; border: 1px solid var(--line); border-radius: 2px; overflow: hidden; }
    .sw-chip { height: 110px; }
    .sw-meta { padding: 0.9rem 1.1rem 1.1rem; }
    .sw-name { font-family: var(--serif); font-size: 1.15rem; margin-bottom: 0.4rem; }
    .sw-hex, .sw-token { font-size: 0.78rem; color: #6a695f; }
    .sw-usage { font-size: 0.8rem; color: #4a4940; margin-top: 0.5rem; }
    .trow { display: grid; gap: 0.5rem; padding: 1.25rem 0; border-top: 1px solid var(--line); }
    .ttag { font-size: 0.7rem; color: #8a897c; }
    .btns { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
    .note { font-size: 0.78rem; color: #6a695f; margin-top: 1.25rem; }
    .tok { border-collapse: collapse; width: 100%; max-width: 46rem; }
    .tok td { border-top: 1px solid var(--line); padding: 0.75rem 1rem 0.75rem 0; font-size: 0.9rem; vertical-align: top; }
    .tok td:first-child { color: var(--olive); white-space: nowrap; }
    .pat { display: grid; gap: 0.25rem; }
    .pat > div { display: grid; grid-template-columns: 12rem 1fr; gap: 1rem; padding: 0.85rem 0; border-top: 1px solid var(--line); }
    .pat dt { font-family: var(--serif); font-size: 1.05rem; }
    .pat dd { color: #4a4940; font-size: 0.92rem; }
    @media (max-width: 620px) { .pat > div { grid-template-columns: 1fr; gap: 0.2rem; } }
  </style>
</Layout>
