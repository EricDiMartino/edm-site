---
// Landing autonome — RATTRAPAGE / correction couleur & coupe (4 salons).
// Différenciée de /coloration-balayage (intention générique) : ici l'intention est
// « couleur/coupe ratée ailleurs → correction ». Indexable. Prête comme landing d'annonces.
// Réservation : boutons par salon avec data-planity → même mécanique que le site
// (tracking reserve_click + booking_confirmed conservé via BookingModal).
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import { grenoble } from '../data/grenoble';
import { montbonnot } from '../data/montbonnot';
import { voiron } from '../data/voiron';
import { aixLesBains } from '../data/aix-les-bains';
import { salonsNav, areaServed } from '../lib/prestations-shared';
import { buildBreadcrumb } from '../lib/schema';
import SiteFooter from '../components/SiteFooter.astro';

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const SALONS = [grenoble, montbonnot, voiron, aixLesBains];

// Déroulé : consultation → diagnostic → correction.
const etapes = [
  { num: '01', titre: 'Consultation', texte: 'On écoute ce qui s’est passé et ce que vous voulez vraiment. On regarde l’état du cheveu, l’historique de couleur, vos photos.' },
  { num: '02', titre: 'Diagnostic', texte: 'On vous dit honnêtement ce qui est possible, en une ou plusieurs séances, et à quel prix. Aucun geste sans votre accord, la fibre d’abord.' },
  { num: '03', titre: 'Correction', texte: 'Neutralisation des reflets indésirables, rééquilibrage de la couleur, remise en forme de la coupe. Un résultat naturel, qui tient.' },
];

// Cas concrets (rassurance « c’est exactement mon problème »).
const cas = [
  { titre: 'Couleur qui a viré', texte: 'Reflets orange, jaunes ou verts, racines trop marquées, résultat plus foncé que prévu.' },
  { titre: 'Balayage raté', texte: 'Démarcation nette, mèches jaunes ou irrégulières, effet « zébré » à rattraper en douceur.' },
  { titre: 'Décoloration abîmée', texte: 'Cheveu fragilisé par un éclaircissement mal maîtrisé : on corrige sans casser la fibre.' },
  { titre: 'Coupe à récupérer', texte: 'Coupe trop courte, déséquilibrée ou mal dégradée ailleurs : on rééquilibre ce qui peut l’être.' },
];

const faq = [
  { question: 'Peut-on toujours rattraper une couleur ratée ?', reponse: 'Souvent oui, parfois en plusieurs étapes pour préserver le cheveu. La consultation sert justement à vous dire ce qui est réaliste, honnêtement, avant toute intervention.' },
  { question: 'Combien coûte un rattrapage couleur ?', reponse: 'Cela dépend de l’état du cheveu et du travail à faire. Le devis est établi en consultation, sans engagement, avant de commencer.' },
  { question: 'Faut-il venir avec les cheveux lavés ?', reponse: 'Non. Venez tels quels, avec si possible des photos de la couleur d’origine et du résultat souhaité : cela aide au diagnostic.' },
  { question: 'Dans quels salons ?', reponse: 'À Grenoble, Montbonnot, Voiron et Aix-les-Bains. Choisissez le salon le plus proche pour réserver votre consultation de rattrapage.' },
];

const seo = {
  title: 'Rattrapage couleur ratée à Grenoble, Montbonnot, Voiron & Aix-les-Bains | Eric Di Martino',
  description: 'Couleur ratée, balayage ou décoloration à corriger, coupe à récupérer ? Nos coloristes visagistes rattrapent après consultation et diagnostic, à Grenoble, Montbonnot, Voiron et Aix-les-Bains.',
};

const providers = SALONS.map((s) => ({
  '@type': 'HairSalon',
  name: `Eric Di Martino — ${s.ville}`,
  telephone: s.telephone,
  address: { '@type': 'PostalAddress', streetAddress: s.adresse, postalCode: s.codePostal, addressLocality: s.ville, addressCountry: 'FR' },
}));
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Correction et rattrapage de couleur',
  name: 'Rattrapage couleur & coupe',
  description: seo.description,
  url: canonical,
  areaServed,
  provider: providers,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.reponse } })),
};
const breadcrumb = buildBreadcrumb([
  { name: 'Accueil', item: new URL('/', Astro.site).href },
  { name: 'Prestations', item: new URL('/prestations-coiffure', Astro.site).href },
  { name: 'Rattrapage couleur', item: canonical },
]);
---

<Layout title={seo.title} description={seo.description} canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(service)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} slot="head" />

  <Header salons={salonsNav} current="prestations" />

  <main>
    <!-- HERO -->
    <section class="section cr-hero">
      <div class="reveal">
        <p class="label">Rattrapage couleur &amp; coupe</p>
        <h1 class="editorial cr-h1">Couleur ratée ailleurs ? <em class="ital">On rattrape.</em></h1>
        <p class="lede cr-lede">Couleur qui a viré, balayage raté, décoloration abîmée, coupe à récupérer : nos coloristes visagistes corrigent après consultation et diagnostic, dans le respect du cheveu, à Grenoble, Montbonnot, Voiron et Aix-les-Bains.</p>
        <div class="cr-actions">
          <a class="btn btn-action" href="#reserver">Réserver un rattrapage</a>
          <a class="btn btn-ghost" href="/coloration-balayage">Coloration &amp; balayage</a>
        </div>
      </div>
    </section>

    <!-- DÉROULÉ -->
    <section class="section cr-etapes">
      <header class="section-head reveal">
        <p class="label">Comment ça se passe</p>
        <h2 class="h-seo">Consultation, diagnostic, correction</h2>
      </header>
      <ol class="cr-etapes-grid reveal" data-d="1">
        {etapes.map((e) => (
          <li class="cr-etape">
            <span class="cr-etape-num" aria-hidden="true">{e.num}</span>
            <h3 class="cr-etape-titre">{e.titre}</h3>
            <p class="cr-etape-texte">{e.texte}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- CAS CONCRETS -->
    <section class="section cr-cas">
      <header class="section-head reveal">
        <p class="label">Ce qu’on rattrape</p>
        <h2 class="h-seo">Vous vous reconnaissez ?</h2>
      </header>
      <ul class="cr-cas-grid reveal" data-d="1">
        {cas.map((c) => (
          <li class="cr-cas-item">
            <h3 class="cr-cas-titre">{c.titre}</h3>
            <p class="cr-cas-texte">{c.texte}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- PREUVES -->
    <section class="cr-preuves">
      <ul class="cr-preuves-grid reveal">
        <li><span class="cr-preuve-v">4,9/5</span><span class="cr-preuve-l">sur Planity</span></li>
        <li><span class="cr-preuve-v">+2500</span><span class="cr-preuve-l">avis clients</span></li>
        <li><span class="cr-preuve-v">4</span><span class="cr-preuve-l">salons en Isère &amp; Savoie</span></li>
        <li><span class="cr-preuve-v">Pro</span><span class="cr-preuve-l">Eric forme d’autres coiffeurs</span></li>
      </ul>
    </section>

    <!-- RÉSERVATION — choix du salon (boutons data-planity → tracking conservé) -->
    <section class="section cr-resa" id="reserver">
      <header class="section-head reveal">
        <p class="label">Réserver</p>
        <h2 class="h-seo">Choisissez votre salon</h2>
        <p class="lede cr-resa-lede">Réservez votre consultation de rattrapage dans le salon le plus proche. On diagnostique ensemble avant toute correction, sans engagement.</p>
      </header>
      <div class="cr-salons reveal" data-d="1">
        {SALONS.map((s) => (
          <a class="btn btn-action cr-salon" href="#reserver" data-reserve data-planity={s.planityKey}>{s.ville}</a>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="section cr-faq">
      <header class="section-head reveal">
        <p class="label">FAQ</p>
        <h2 class="h-seo">Bon à savoir</h2>
      </header>
      <div class="cr-faq-list reveal" data-d="1">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.question}<span class="faq-plus" aria-hidden="true"></span></summary>
            <div class="rt"><p>{f.reponse}</p></div>
          </details>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter sub="Rattrapage couleur &amp; coupe · Grenoble · Montbonnot · Voiron · Aix-les-Bains" />

  <style>
    .cr-h1 { max-width: 16ch; }
    .cr-h1 em { font-style: italic; color: var(--olive); }
    .cr-lede { max-width: 54ch; }
    .cr-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.8rem; }

    /* Déroulé */
    .cr-etapes-grid { list-style: none; margin: clamp(1.5rem,4vw,2.5rem) 0 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: clamp(1rem,3vw,1.5rem); counter-reset: none; }
    .cr-etape { background: var(--cream); border-radius: var(--radius); padding: clamp(1.4rem,3vw,1.9rem); }
    .cr-etape-num { display: block; font-family: var(--serif); font-size: 1.5rem; color: var(--olive); margin-bottom: 0.5rem; }
    .cr-etape-titre { font-family: var(--serif); font-weight: 400; font-size: 1.3rem; margin: 0 0 0.4rem; }
    .cr-etape-texte { color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0; }

    /* Cas concrets */
    .cr-cas-grid { list-style: none; margin: clamp(1.5rem,4vw,2.5rem) 0 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: clamp(1rem,3vw,1.5rem); }
    .cr-cas-item { border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(1.3rem,3vw,1.7rem); }
    .cr-cas-titre { font-family: var(--serif); font-weight: 400; font-size: 1.2rem; margin: 0 0 0.4rem; }
    .cr-cas-texte { color: var(--muted); font-size: 0.92rem; line-height: 1.55; margin: 0; }

    /* Preuves */
    .cr-preuves { background: var(--cream); border-block: 1px solid var(--line); }
    .cr-preuves-grid { max-width: var(--maxw); margin-inline: auto; list-style: none; padding: clamp(2.25rem,5vw,3.25rem) var(--gutter); display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(1.5rem,4vw,2.5rem); text-align: center; }
    .cr-preuve-v { display: block; font-family: var(--serif); font-weight: 380; font-size: clamp(1.8rem,1.2rem + 2.2vw,2.8rem); line-height: 1; color: var(--ink); }
    .cr-preuve-l { display: block; margin-top: 0.5rem; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }

    /* Réservation */
    .cr-resa-lede { max-width: 52ch; }
    .cr-salons { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: clamp(1.5rem,4vw,2.25rem); }
    .cr-salon { flex: 0 1 auto; }

    /* FAQ */
    .cr-faq-list { border-top: 1px solid var(--line); max-width: 820px; }

    @media (min-width: 720px) {
      .cr-etapes-grid { grid-template-columns: repeat(3, 1fr); }
      .cr-cas-grid { grid-template-columns: repeat(2, 1fr); }
      .cr-preuves-grid { grid-template-columns: repeat(4, 1fr); }
    }
  </style>
</Layout>
