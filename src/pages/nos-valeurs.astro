---
// Page "Nos valeurs / engagements" — /nos-valeurs. Objectif référencement + marque.
// Visagisme & santé du cheveu, engagement cancer, environnement (Capillum),
// produits engagés (Authentic Beauty Concept).
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import { salonsNav } from '../lib/prestations-shared';

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const engagements = [
  {
    titre: 'Aux côtés des personnes touchées par le cancer',
    texte: 'La maladie et ses traitements bouleversent le rapport aux cheveux. Nous accueillons les personnes concernées avec écoute et discrétion, et les accompagnons sur la perte, la repousse et les solutions adaptées — dans un cadre bienveillant.',
    icon: 'heart',
  },
  {
    titre: 'Le recyclage des cheveux, avec Capillum',
    texte: 'Plutôt que de finir à la poubelle, les cheveux coupés dans nos salons sont collectés et valorisés par Capillum, la première filière française de recyclage du cheveu : paillage pour l’agriculture, boudins dépolluants (qui absorbent les hydrocarbures), et recherche médicale.',
    icon: 'leaf',
  },
  {
    titre: 'Des produits engagés — Authentic Beauty Concept',
    texte: 'Nous travaillons avec Authentic Beauty Concept : des soins professionnels vegan, sans sulfates ni silicones, certifiés cruelty-free (PETA, Vegan Society). De belles formules, plus respectueuses du cheveu comme de la planète.',
    icon: 'sparkle',
  },
];

const ICONS: Record<string, string> = {
  heart: '<path d="M12 20s-7-4.5-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.5-9.5 9-9.5 9z"/>',
  leaf: '<path d="M5 19c0-8 6-14 14-14 0 8-6 14-14 14z"/><path d="M5 19c4-4 7-7 11-9"/>',
  sparkle: '<path d="M12 3l1.9 5.6L20 10l-6.1 1.4L12 17l-1.9-5.6L4 10l6.1-1.4z"/>',
};

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Eric Di Martino',
  url: new URL('/', Astro.site).href,
  description: 'Salons de coiffure visagistes engagés : santé du cheveu, accompagnement des personnes touchées par le cancer, recyclage des cheveux (Capillum) et produits vegan (Authentic Beauty Concept).',
  areaServed: ['Grenoble', 'Montbonnot-Saint-Martin', 'Voiron', 'Aix-les-Bains', 'Isère', 'Savoie'],
  sameAs: [
    'https://www.instagram.com/salon_eric_di_martino_grenoble/',
    'https://www.instagram.com/salon_ericdimartino_montbonnot/',
    'https://www.instagram.com/salon_eric_di_martino_voiron/',
    'https://www.instagram.com/salon_ericdimartino_aix/',
    'https://www.facebook.com/salonericdimartino/',
  ],
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Nos valeurs', item: canonical },
  ],
};
---

<Layout title="Nos valeurs — une coiffure engagée | Eric Di Martino" description="Les engagements des salons Eric Di Martino : santé du cheveu et visagisme, accompagnement des personnes touchées par le cancer, recyclage des cheveux avec Capillum, produits vegan Authentic Beauty Concept." canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(organization)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} slot="head" />

  <Header salons={salonsNav} current="histoire" />

  <main>
    <section class="section nv-hero">
      <div class="reveal">
        <p class="label">Nos valeurs</p>
        <h1 class="editorial nv-h1">Une coiffure <em class="ital">engagée</em>.</h1>
        <p class="lede nv-lede">Chez Eric Di Martino, la beauté ne se sépare pas du soin : la santé du cheveu d’abord, l’accompagnement des plus fragiles, et des choix responsables — du produit jusqu’au recyclage.</p>
      </div>
    </section>

    <!-- Notre approche : visagisme & santé du cheveu -->
    <section class="section nv-split">
      <div class="nv-split-visual reveal"><div class="frame"></div></div>
      <div class="nv-split-copy reveal" data-d="1">
        <p class="label">Notre approche</p>
        <h2 class="h-seo">Le cheveu, d’abord en bonne santé</h2>
        <p class="body">Notre signature, c’est le visagisme : avant chaque coupe ou couleur, un diagnostic — mode de vie, géométrie du visage, et surtout l’état réel du cheveu et du cuir chevelu.</p>
        <p class="body">Parce qu’une belle coiffure part d’un cheveu sain, nous privilégions les gestes et les soins qui respectent la fibre, et nous vous conseillons une routine adaptée à la maison.</p>
        <a class="link-arrow link-olive" href="/consultation-visagiste-coloriste">La consultation visagiste<span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- Nos engagements -->
    <section class="section nv-engage-sec">
      <header class="section-head reveal">
        <p class="label">Nos engagements</p>
        <h2 class="h-seo">Une beauté qui prend ses responsabilités</h2>
      </header>
      <ul class="nv-engage reveal" data-d="1">
        {engagements.map((e) => (
          <li class="nv-eng">
            <svg class="nv-eng-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[e.icon] ?? ICONS.leaf} />
            <div class="nv-eng-body">
              <h3>{e.titre}</h3>
              <p>{e.texte}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="section nv-cta">
      <div class="nv-cta-inner reveal">
        <p class="editorial nv-cta-title">Une beauté qui a du sens.</p>
        <p class="lede nv-cta-lede">Réservez votre consultation — on prend soin de vos cheveux, vraiment.</p>
        <div class="nv-cta-links">
          <a class="btn btn-action" href="#reserver">Réserver</a>
          <a class="link-arrow link-cream" href="/nos-salons-de-coiffure">Nos salons<span class="arrow" aria-hidden="true">→</span></a>
          <a class="link-arrow link-cream" href="/prestations-coiffure">Nos prestations<span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="nv-footer">
    <p class="nv-foot-mark">Eric Di Martino</p>
    <p class="nv-foot-sub">Salons de coiffure · Grenoble · Montbonnot · Voiron · Aix-les-Bains</p>
  </footer>

  <style>
    .nv-h1 { max-width: 14ch; }
    .nv-h1 em { font-style: italic; color: var(--olive); }
    .nv-lede { max-width: 54ch; }

    /* Approche (split) */
    .nv-split { display: grid; gap: clamp(2rem,5vw,3.5rem); align-items: center; }
    .nv-split-visual .frame { aspect-ratio: 4 / 3; }
    .nv-split-copy .body { margin: 1rem 0; }
    .nv-split-copy .body + .body { margin-top: 0; }

    /* Engagements */
    .nv-engage { list-style: none; margin: clamp(1.5rem,4vw,2.5rem) 0 0; padding: 0; border-top: 1px solid var(--line); }
    .nv-eng { display: grid; grid-template-columns: auto 1fr; gap: clamp(1rem,3vw,1.75rem); padding: clamp(1.5rem,4vw,2.25rem) 0; border-bottom: 1px solid var(--line); align-items: start; }
    .nv-eng-ico { width: 30px; height: 30px; color: var(--terracotta); flex: none; margin-top: 0.2rem; }
    .nv-eng-body h3 { font-family: var(--serif); font-weight: 400; font-size: clamp(1.25rem,1.1rem+0.6vw,1.55rem); margin: 0 0 0.5rem; color: var(--ink); }
    .nv-eng-body p { color: var(--muted); font-size: 0.98rem; line-height: 1.65; margin: 0; max-width: 64ch; }

    /* CTA */
    .nv-cta { padding-left: 0; padding-right: 0; }
    .nv-cta-inner { background: var(--olive); color: #fff; padding: clamp(3rem,8vw,5.5rem) var(--gutter); text-align: center; }
    .nv-cta-title { color: #fff; }
    .nv-cta-lede { color: rgba(255,255,255,0.86); margin-left: auto; margin-right: auto; max-width: 44ch; }
    .nv-cta-links { display: flex; flex-wrap: wrap; gap: 1rem 1.75rem; align-items: center; justify-content: center; margin-top: 2rem; }

    .nv-footer { max-width: var(--maxw); margin-inline: auto; padding: clamp(3rem,6vw,4.5rem) var(--gutter) 3rem; border-top: 1px solid var(--line); }
    .nv-foot-mark { font-family: var(--serif); font-size: 1.4rem; margin: 0; }
    .nv-foot-sub { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--olive); margin: 0.4rem 0 0; }

    @media (min-width: 820px) {
      .nv-split { grid-template-columns: 0.95fr 1.05fr; }
      .nv-cta { padding-left: var(--gutter); padding-right: var(--gutter); }
      .nv-cta-inner { border-radius: var(--radius); }
    }
  </style>
</Layout>
