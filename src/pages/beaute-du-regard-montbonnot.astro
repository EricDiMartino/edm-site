---
// Page BEAUTÉ DU REGARD — Montbonnot. Thème clair (design system). Signature
// esthétique du salon de Montbonnot (Audrey, artiste du regard).
// Contenu repris du site actuel (/salon-esthetique). Aucun prix (cohérent site).
// Réservation routée Montbonnot via [data-planity] (BookingModal global).
import { Image } from 'astro:assets';
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import audreyPhoto from '../assets/salons/montbonnot/equipe/audrey.webp';
import { salonsNav } from '../lib/prestations-shared';
import { montbonnot as m } from '../data/montbonnot';
import { buildBreadcrumb } from '../lib/schema';
import SiteFooter from '../components/SiteFooter.astro';
import CtaBlock from '../components/CtaBlock.astro';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const telHref = 'tel:' + m.telephone.replace(/[^0-9+]/g, '');
const cpVille = `${m.codePostal} ${m.ville}`;
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent([m.adresse, m.codePostal, m.ville].join(', '))}&z=16&output=embed`;

// Horaires PROPRES à la beauté du regard (Audrey) : ouvert le LUNDI, contrairement au salon coiffure de Montbonnot.
const bdrHoraires = [
  { jour: 'Lundi', valeur: '9h – 18h' },
  { jour: 'Mardi', valeur: '9h – 19h' },
  { jour: 'Mercredi', valeur: '9h – 18h' },
  { jour: 'Jeudi', valeur: '10h – 19h' },
  { jour: 'Vendredi', valeur: '9h – 16h' },
  { jour: 'Samedi', valeur: 'Fermé', ferme: true },
  { jour: 'Dimanche', valeur: 'Fermé', ferme: true },
];

// Filtre widget Planity (serviceSetsWhitelist) = ids des ensembles « beauté du regard » à Montbonnot.
// Focus Audrey : maquillage permanent (sourcils/lèvres) mis en avant + consultation MP + teinture, épilation gardée (clientes existantes).
//  -OyiGerS… Consultation maquillage permanent · -NLMvRhc… Sourcils MP · -NLMyZE… Lèvres MP
//  -NLMvjJ… Teintures sourcils & cils · -NL5-bso… Épilations
// ⚠️ ids Firebase stables mais opaques : si un ensemble est supprimé/recréé dans Planity, mettre à jour ici.
const regardServiceSets = '-OyiGerS2kgE4EEYaB82,-NLMvRhc5KCm7kMRS6xk,-NLMyZEQhgdD2SKm9FCe,-NLMvjJxJZaWLxeOsdPV,-NL5-bso_6DT5YlT_4X1';

// Icônes filaires des cards.
const ICONS: Record<string, string> = {
  brow: '<path d="M3 13c3-4 7-6 12-6 3 0 5 .8 6 1.6"/><path d="M5 11.5c2.5-1.4 5-2 7.5-2"/>',
  eye: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/><path d="M4 7l1.5 2M20 7l-1.5 2M12 4.5V7"/>',
  pen: '<path d="M14 4l6 6L9 21l-5 1 1-5z"/><path d="M12 6l6 6"/>',
  lips: '<path d="M3 12c2.5-2 5-2 9 0.5 4-2.5 6.5-2.5 9-0.5"/><path d="M3 12c2.5 3 5.5 3.5 9 1 3.5 2.5 6.5 2 9-1"/>',
};
// Cards : les 2 maquillage permanent (mis en avant) d'abord, puis l'expertise sourcils et la teinture des cils.
const univers = [
  { titre: 'Maquillage permanent des sourcils', icon: 'pen', texte: 'Un dessin durable et précis des sourcils : effet poudré, poil à poil ou mélange des deux. Un regard structuré au quotidien, par une spécialiste de la technique à Montbonnot.' },
  { titre: 'Maquillage permanent des lèvres', icon: 'lips', texte: 'Redessiner le contour et raviver la couleur des lèvres durablement, tout en naturel. Un maquillage permanent longue tenue, réalisé sur consultation.' },
  { titre: 'Sourcils', icon: 'brow', texte: 'Restructuration, création de ligne et teinture des sourcils à Montbonnot : une ligne dessinée selon la forme de votre visage. La structure qui change tout un regard.' },
  { titre: 'Cils', icon: 'eye', texte: 'Teinture des cils : un regard plus intense et défini, tout en naturel, sans mascara au quotidien.' },
];

const faq = [
  { question: 'Où faire son maquillage permanent près de Montbonnot ?', reponse: `Au salon Eric Di Martino de Montbonnot, ${m.adresse}, ${cpVille}, sur rendez-vous avec Audrey, notre spécialiste du regard. Un rendez-vous facile d’accès depuis Meylan, Saint-Ismier, Biviers, Crolles et Grenoble.` },
  { question: 'Peut-on combiner beauté du regard et coiffure ?', reponse: 'Oui : vous pouvez réserver une prestation du regard seule, ou en complément d’un rendez-vous coiffure dans le même salon de Montbonnot.' },
  { question: 'Proposez-vous le paiement en plusieurs fois ?', reponse: 'Oui, le paiement en 3 ou 4 fois est possible sur les prestations beauté du regard.' },
  { question: 'Faut-il une consultation avant un maquillage permanent ?', reponse: 'Oui. Chaque maquillage permanent (sourcils ou lèvres) commence par une consultation pour définir la forme, la teinte et valider ensemble le rendu souhaité avant la réalisation.' },
];

// Schémas SEO / GEO
const provider = {
  '@type': 'BeautySalon',
  name: `Eric Di Martino — ${m.ville}`,
  telephone: m.telephone,
  address: { '@type': 'PostalAddress', streetAddress: m.adresse, postalCode: m.codePostal, addressLocality: m.ville, addressCountry: 'FR' },
  sameAs: [m.instagram.url],
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Beauté du regard',
  name: 'Beauté du regard — maquillage permanent, sourcils, cils',
  description: 'Maquillage permanent des sourcils et des lèvres, restructuration et teinture des sourcils, teinture des cils, à Montbonnot.',
  url: canonical,
  areaServed: m.areaServed,
  provider,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.reponse } })),
};
const breadcrumb = buildBreadcrumb([{ name: 'Accueil', item: new URL('/', Astro.site).href }, { name: 'Beauté du regard', item: canonical }]);

const seo = {
  title: 'Maquillage permanent & beauté du regard à Montbonnot | Eric Di Martino',
  description: 'Maquillage permanent des sourcils et des lèvres, teinture et restructuration des sourcils, teinture des cils à Montbonnot. Avec Audrey, spécialiste du regard, sur rendez-vous.',
};
---

<Layout title={seo.title} description={seo.description} canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} slot="head" />

  <Header tel={m.telephone} reservationUrl="#reserver" reserveKey={m.planityKey} reserveCat={regardServiceSets} salons={salonsNav} current="beauteregard" />

  <main class="bdr" data-planity={m.planityKey} data-cat={regardServiceSets}>
    <!-- HERO -->
    <section class="section bdr-hero">
      <div class="bdr-hero-copy reveal">
        <p class="label">{m.ville} · L'artiste du regard</p>
        <h1 class="editorial bdr-h1">La beauté du <em class="ital">regard</em>.</h1>
        <p class="lede bdr-lede">Beauté du regard à Montbonnot : maquillage permanent des sourcils et des lèvres, sourcils redessinés, teinture des cils. Audrey sublime votre regard avec la même exigence que nos prestations coiffure, toujours à partir de la forme de votre visage.</p>
        <div class="bdr-actions">
          <a class="btn btn-action" href="#reserver" data-reserve>Prendre rendez-vous</a>
          <a class="btn btn-ghost" href="#univers">Voir les prestations</a>
        </div>
      </div>
      <aside class="bdr-hero-panel reveal" data-d="1">
        <p class="bdr-panel-eyebrow">En pratique</p>
        <ul class="bdr-panel-list">
          <li><span>Salon</span><span>Montbonnot</span></li>
          <li><span>Adresse</span><span>{m.adresse}</span></li>
          <li><span>Téléphone</span><a href={telHref}>{m.telephone}</a></li>
          <li><span>Paiement</span><span>3× ou 4×</span></li>
        </ul>
      </aside>
    </section>

    <!-- APPROCHE -->
    <section class="section bdr-approche">
      <div class="bdr-approche-copy reveal">
        <p class="label">Notre approche</p>
        <h2 class="h-seo">Le regard, prolongement du visage</h2>
        <p class="body">Un regard se travaille comme une coupe : selon la géométrie du visage, la nature du poil et vos envies. Avant chaque maquillage permanent, teinture ou restructuration des sourcils, Audrey prend le temps du diagnostic, pour un résultat naturel, qui vous ressemble et se vit simplement au quotidien.</p>
        <a class="link-arrow link-olive" href="/consultation-visagiste-coloriste">Notre philosophie de la consultation<span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="bdr-approche-video reveal" data-d="1">
        <button class="bdr-reel" type="button" data-bdr-video aria-label="Lire la présentation d'Audrey">
          <video src="/audrey-presentation.mp4" poster="/audrey-presentation-poster.jpg" playsinline preload="none"></video>
          <span class="bdr-reel-play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          <span class="bdr-reel-cap">Audrey, artiste du regard</span>
        </button>
      </div>
    </section>

    <!-- LES 4 UNIVERS -->
    <section class="section bdr-univers" id="univers">
      <header class="section-head reveal">
        <p class="label">Nos prestations</p>
        <h2 class="h-seo">Maquillage permanent, sourcils et cils à Montbonnot</h2>
      </header>
      <ul class="bdr-grid reveal" data-d="1">
        {univers.map((u) => (
          <li class="bdr-card">
            <svg class="bdr-card-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[u.icon]} />
            <h3 class="bdr-card-titre">{u.titre}</h3>
            <p class="bdr-card-texte">{u.texte}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- AUDREY -->
    <section class="section bdr-praticienne">
      <figure class="bdr-portrait reveal">
        <Image src={audreyPhoto} widths={[360, 480, 640]} sizes="(min-width: 820px) 40vw, 90vw" alt="Audrey, artiste du regard au salon Eric Di Martino de Montbonnot" loading="lazy" />
        <figcaption>Audrey</figcaption>
      </figure>
      <div class="bdr-praticienne-copy reveal" data-d="1">
        <p class="label">La praticienne</p>
        <h2 class="h-seo">Audrey, artiste du regard</h2>
        <p class="body">Sept ans d'expérience et une spécialité : le maquillage permanent. Main douce et assurée, Audrey met sa précision au service de votre regard (sourcils, lèvres, dessin durable) pour un résultat naturel à Montbonnot.</p>
        <a class="link-arrow link-olive" href={m.instagram.url} target="_blank" rel="noopener">Voir son travail sur Instagram<span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- LIEU -->
    <section class="section bdr-lieu">
      <div class="bdr-lieu-visual reveal">
        <iframe title={`Carte — Salon ${m.ville}`} src={mapEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="bdr-lieu-copy reveal" data-d="1">
        <p class="label">Le lieu</p>
        <h2 class="h-seo">Beauté du regard au salon de Montbonnot</h2>
        <p class="bdr-lieu-addr">{m.adresse}<br />{cpVille}</p>
        <ul class="bdr-hours">
          {bdrHoraires.map((hr) => (
            <li class={hr.ferme ? 'is-closed' : ''}><span>{hr.jour}</span><span>{hr.valeur}</span></li>
          ))}
        </ul>
        <p class="bdr-lieu-note">Paiement en 3× ou 4× · sur rendez-vous</p>
        <div class="bdr-lieu-links">
          <a class="link-arrow link-olive" href="/salon-de-coiffure/montbonnot">Découvrir le salon<span class="arrow" aria-hidden="true">→</span></a>
          <a class="link-arrow link-olive" href={m.mapsUrl} target="_blank" rel="noopener">Itinéraire<span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section bdr-faq-sec">
      <header class="section-head reveal">
        <p class="label">Questions fréquentes</p>
        <h2 class="h-seo">Avant de réserver</h2>
      </header>
      <div class="bdr-faq reveal" data-d="1">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.question}<span class="faq-plus" aria-hidden="true"></span></summary>
            <div class="rt"><p>{f.reponse}</p></div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <CtaBlock id="reserver" title="Sublimez votre regard." lede="Rendez-vous avec Audrey, au salon de Montbonnot."><a class="btn btn-action btn-lg" href="#reserver" data-reserve>Prendre rendez-vous</a><p class="cta-band-tel">ou par téléphone : <a href={telHref}>{m.telephone}</a></p></CtaBlock>
  </main>

  <script>
    // Vidéo reel « Notre approche » : clic pour lire (avec le son), retour au poster à la fin.
    const reel = document.querySelector('[data-bdr-video]');
    if (reel) {
      const video = reel.querySelector('video');
      reel.addEventListener('click', () => {
        if (!video) return;
        if (video.paused) { reel.classList.add('is-playing'); video.play(); }
        else { video.pause(); reel.classList.remove('is-playing'); }
      });
      video?.addEventListener('ended', () => { reel.classList.remove('is-playing'); video.currentTime = 0; });
    }
  </script>

  <SiteFooter sub={`Beauté du regard · Salon de Montbonnot · ${m.adresse}, ${cpVille}`} />

  <style>
    .bdr em.ital { font-style: italic; color: var(--olive); }

    /* HERO */
    .bdr-hero { display: grid; gap: clamp(2rem, 5vw, 3.5rem); align-items: center; padding-top: clamp(2.5rem, 6vw, 4.5rem); }
    .bdr-h1 { max-width: 14ch; }
    .bdr-lede { max-width: 52ch; margin-top: 1.1rem; }
    .bdr-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.9rem; }
    .bdr-hero-panel { background: var(--cream); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(1.5rem, 4vw, 2rem); }
    .bdr-panel-eyebrow { font-family: var(--sans); font-weight: 600; font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--olive); margin: 0 0 0.6rem; }
    .bdr-panel-list { list-style: none; margin: 0; padding: 0; }
    .bdr-panel-list li { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 0.8rem 0; border-bottom: 1px solid var(--line); }
    .bdr-panel-list li:last-child { border-bottom: 0; padding-bottom: 0; }
    .bdr-panel-list span:first-child { font-family: var(--sans); font-size: 0.64rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
    .bdr-panel-list span:last-child, .bdr-panel-list a { font-family: var(--serif); font-size: 1.05rem; color: var(--ink); text-align: right; text-decoration: none; }
    .bdr-panel-list a:hover { color: var(--terracotta); }

    /* APPROCHE */
    .bdr-approche { border-top: 1px solid var(--line); display: grid; gap: clamp(2rem, 5vw, 3.5rem); align-items: center; }
    .bdr-approche-copy { max-width: 60ch; }
    .bdr-approche-copy .body { margin: 1.1rem 0 1.4rem; }
    .bdr-approche-video { display: flex; justify-content: center; }
    /* Vidéo format reel Instagram (9:16) — clic pour lire (présentation Audrey) */
    .bdr-reel { position: relative; width: 100%; max-width: 300px; aspect-ratio: 9 / 16; border-radius: var(--radius); overflow: hidden; background: linear-gradient(150deg, var(--cream), var(--cream-deep)); box-shadow: inset 0 0 0 1px var(--line); border: 0; padding: 0; cursor: pointer; display: block; }
    .bdr-reel video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .bdr-reel-play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 62px; height: 62px; border-radius: 50%; background: rgba(255,255,255,0.92); display: grid; place-items: center; color: var(--terracotta); box-shadow: 0 10px 30px -10px rgba(38,38,31,0.5); transition: transform 0.4s var(--ease), opacity 0.3s; }
    .bdr-reel-play svg { width: 24px; height: 24px; margin-left: 3px; }
    .bdr-reel:hover .bdr-reel-play { transform: translate(-50%, -50%) scale(1.06); }
    .bdr-reel-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 2.2rem 1rem 0.9rem; font-family: var(--sans); font-weight: 500; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: #fff; text-align: center; background: linear-gradient(to top, rgba(0,0,0,0.55), transparent); transition: opacity 0.3s; }
    .bdr-reel.is-playing { cursor: default; }
    .bdr-reel.is-playing .bdr-reel-play, .bdr-reel.is-playing .bdr-reel-cap { opacity: 0; pointer-events: none; }
    @media (min-width: 820px) { .bdr-approche { grid-template-columns: 1.5fr 0.5fr; } }

    /* UNIVERS */
    .bdr-univers { border-top: 1px solid var(--line); }
    .bdr-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: clamp(1rem, 3vw, 1.5rem); }
    .bdr-card { background: var(--cream); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(1.6rem, 4vw, 2.1rem); }
    .bdr-card-ico { width: 30px; height: 30px; color: var(--terracotta); margin-bottom: 1.1rem; }
    .bdr-card-titre { font-family: var(--serif); font-weight: 400; font-size: 1.4rem; color: var(--ink); margin: 0 0 0.6rem; }
    .bdr-card-texte { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.65; }

    /* PRATICIENNE */
    .bdr-praticienne { display: grid; gap: clamp(2rem, 5vw, 3.5rem); align-items: center; border-top: 1px solid var(--line); }
    .bdr-portrait { position: relative; aspect-ratio: 4 / 5; border-radius: var(--radius); overflow: hidden; margin: 0; box-shadow: inset 0 0 0 1px var(--line);
      background: radial-gradient(120% 90% at 75% 15%, rgba(194,85,16,0.14), transparent 55%), linear-gradient(150deg, var(--cream) 0%, var(--cream-deep) 60%, #d9d4bf 100%); }
    .bdr-portrait img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .bdr-portrait::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.35), transparent 38%); pointer-events: none; }
    .bdr-portrait figcaption { position: absolute; z-index: 1; left: 1.1rem; bottom: 0.9rem; font-family: var(--sans); font-size: 0.64rem; letter-spacing: 0.2em; text-transform: uppercase; color: #fff; }
    .bdr-praticienne-copy .body { margin: 1.1rem 0 1.4rem; max-width: 48ch; }

    /* LIEU */
    .bdr-lieu { display: grid; gap: clamp(2rem, 5vw, 3.5rem); align-items: center; border-top: 1px solid var(--line); }
    .bdr-lieu-visual { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; box-shadow: inset 0 0 0 1px var(--line); background: var(--cream); }
    .bdr-lieu-visual iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }
    .bdr-lieu-addr { color: var(--ink); margin: 1rem 0 0; line-height: 1.6; }
    .bdr-hours { list-style: none; margin: 1.3rem 0 0; padding: 0; max-width: 22rem; }
    .bdr-hours li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid var(--line); font-size: 0.92rem; }
    .bdr-hours .is-closed { color: var(--muted); }
    .bdr-lieu-note { margin: 1.2rem 0 0; font-family: var(--sans); font-size: 0.8rem; letter-spacing: 0.04em; color: var(--olive-deep); }
    .bdr-lieu-links { display: flex; flex-wrap: wrap; gap: 1.25rem 2rem; margin-top: 1.5rem; }

    /* FAQ */
    .bdr-faq-sec { border-top: 1px solid var(--line); }
    .bdr-faq { border-top: 1px solid var(--line); max-width: 820px; margin-top: 1.25rem; }

    /* CTA */

    /* FOOTER */

    @media (min-width: 640px) { .bdr-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 820px) {
      .bdr-hero { grid-template-columns: 1.2fr 0.8fr; align-items: end; }
      .bdr-praticienne { grid-template-columns: 0.8fr 1fr; }
      .bdr-lieu { grid-template-columns: 1fr 1fr; }
    }
  </style>
</Layout>
