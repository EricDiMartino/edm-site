---
// ACADEMY LEADER — Ouvrir (/formation/ouvrir-un-salon-de-coiffure).
// Balisage + texte = maquette (formation-src/code/dist, vérifié mot à mot contre formation-src/maquette.html).
// SEO / FAQ / appel final : src/data/formation/pages.ts.
import FormationLayout from '../../components/formation/FormationLayout.astro';
import { Image } from 'astro:assets';
import salonImg from '../../assets/formation/photos/salon-de-coiffure-grenoble-place-victor-hugo-ouverture.webp';
import ouvertureImg from '../../assets/formation/photos/ouverture-salon-de-coiffure-grenoble-eric-di-martino.webp';
import FormationFaq from '../../components/formation/FormationFaq.astro';
import FormationFinalCta from '../../components/formation/FormationFinalCta.astro';
import { ouvrirSeo as seo, ouvrirFaq as faq, ouvrirFin as fin } from '../../data/formation/pages';
import { heroFranchise, franchise } from '../../data/formation/franchise';
import { heroClaim, piliers, gains, engagement, sim } from '../../data/formation/ouvrir';
import type { ImageMetadata } from 'astro';
import { orgRef, SITE, url } from '../../data/formation/site';
// Photos des 3 piliers : src/assets/formation/photos/piliers/{img}.webp (1200×900). Absente = visuel de remplacement.
const pilierImgs = import.meta.glob<{ default: ImageMetadata }>('../../assets/formation/photos/piliers/*.webp', { eager: true });
const piliersV = piliers.map((p) => ({ ...p, image: pilierImgs[`../../assets/formation/photos/piliers/${p.img}.webp`]?.default }));

// JSON-LD (maquette : Service · HowTo · FAQPage — la FAQ est balisée par FormationFaq)
const pageUrl = `${SITE}${url.ouvrir}`;
const etapes = [
  ['Savoir si le projet tient debout', "Ce que ta zone absorbe vraiment, et ce que chaque prestation te laissera à la minute. Calculé et analysé avant de décider."],
  ['Écrire ton concept, dessiner tes murs', "Positionnement, grille tarifaire et agencement se décident avant l'ouverture. Pas une fois les équipes en place. C'est ce trio qui fixe ta marge pour toute la durée du bail."],
  ['Choisir tes partenaires, monter ton équipe', 'Conditions fournisseur et première embauche, on négocie avec toi au moment où tu as le moins de pouvoir de négociation.'],
  ['Ouvrir avec des plannings remplis et un résultat garanti', 'Des clients le premier jour. Six mois de correction des écarts, et on reste avec toi les deux premières années pour garantir tes résultats'],
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', name: 'Accompagnement à l\'ouverture d\'un salon de coiffure', serviceType: 'Accompagnement ouverture de salon de coiffure', description: seo.description, url: pageUrl, provider: orgRef, areaServed: 'FR', audience: { '@type': 'BusinessAudience', audienceType: 'Porteurs de projet de salon de coiffure' } },
    { '@type': 'HowTo', name: 'Ouvrir un salon de coiffure rentable, en 7 étapes', url: pageUrl, step: etapes.map(([name, text], i) => ({ '@type': 'HowToStep', position: i + 1, name, text })) },
  ],
};
---

<FormationLayout title={seo.title} description={seo.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <main>
    <section class="s10 al-hero-ouvrir">
      <div class="s11">
        <div>
          <div class="s12">{heroFranchise.eyebrow}</div>
          <h1 class="s80 al-h1-ouvrir">{heroFranchise.h1a} <span class="s5">{heroFranchise.h1b}</span></h1>
          <p class="al-claim"><b>{heroClaim.h}</b> <span>{heroClaim.chips.join(' · ')}</span></p>
          <div class="s83">
            <a href="/formation/diagnostic" class="s84"><b class="s18">Découvre si c'est le bon moment</b></a>
          </div>
        </div>
        <div class="s86 al-media"><Image src={salonImg} alt="Salon de coiffure Eric Di Martino ouvert en février 2026, place Victor Hugo à Grenoble" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 540px" loading="eager" /></div>
      </div>
    </section>
    <section id="franchise" class="al-fr">
      <div class="s33">
        <div class="s47">{franchise.label}</div>
        <h2 class="s34">Les avantages d'une franchise, <span class="s5"><br />la liberté d'un indépendant.</span></h2>
        <p class="al-fr-intro">{franchise.intro}</p>
        <div class="al-piliers">
          {piliersV.map((x, i) => (
            <div class={`al-pilier${i === 1 ? ' al-pilier--acc' : ''}`}>
              <div class="al-pilier-img">
                {x.image && <Image src={x.image} alt={x.alt} widths={[400, 800]} sizes="(max-width: 900px) 100vw, 380px" />}
                {!x.image && <div class="al-pilier-ph"><small>{`${x.img}.webp`}</small></div>}
                <span class="al-pilier-k">{x.k}</span>
                {x.big && <span class="al-pilier-big">{x.big}</span>}
              </div>
              <h3>{x.t}</h3>
              <p>{x.p}</p>
              {x.list && <ul class="al-pilier-list">{x.list.map((t) => <li>{t}</li>)}</ul>}
              {x.partners && <div class="al-partners"><span class="al-partners-l">Nos partenaires</span><div>{x.partners.map((t) => <b>{t}</b>)}</div></div>}
            </div>
          ))}
        </div>
        <a href={url.diagnostic} class="s84 al-fr-cta"><b class="s18">{franchise.cta.label}</b><span class="s19">{franchise.cta.sub}</span></a>
      </div>
    </section>
    <section class="s46 al-gains">
      <div class="s33">
        <div class="s47">{gains.label}</div>
        <h2 class="s34">{gains.h2a} <span class="s5"><br />{gains.h2b}</span></h2>
        <div class="al-gains-grid">
          {gains.ouverture.map((g, i) => (
            <div class={`al-gain${i === 0 ? ' al-gain--lead' : ''}`}>
              <span class="al-gain-n" aria-hidden="true">0{i + 1}</span>
              <h3>{g.t}</h3>
              <p>{g.p}</p>
              {g.tags.length > 0 && <div class="al-gain-tags">{g.tags.map((t) => <span>{t}</span>)}</div>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="s59 al-engage">
      <div class="s33">
        <div class="al-proof al-proof--wide">
          <div class="al-proof-img al-media"><Image src={ouvertureImg} alt="Espace coiffure du salon de Grenoble le jour de l'ouverture" widths={[480, 900]} sizes="(max-width: 900px) 100vw, 520px" /></div>
          <div class="al-proof-txt">
            <h2 class="al-proof-big">{engagement.preuveTitre[0]} <span>{engagement.preuveTitre[1]}</span></h2>
            <div class="al-proof-sub">{engagement.preuveSous}</div>
            <p>{engagement.preuveTexte}</p>
            <small>{engagement.preuveFine}</small>
          </div>
        </div>
        <form class="al-plaq" data-plaquette>
          <div class="al-plaq-visual" aria-hidden="true">
            <div class="al-plaq-page al-plaq-page--back"></div>
            <div class="al-plaq-page al-plaq-page--mid"></div>
            <div class="al-plaq-page al-plaq-cover">
              <div class="al-plaq-brand">Academy <span>Leader</span></div>
              <div class="al-plaq-cover-img"><Image src={salonImg} alt="" widths={[400]} sizes="220px" /></div>
              <b>Ouvrir ton salon de coiffure, <em>sans être seul.</em></b>
            </div>
          </div>
          <div class="al-plaq-body">
            <div class="s47">{engagement.plaquette.label}</div>
            <h2 class="al-plaq-h">{engagement.plaquette.h}</h2>
            <ul class="al-plaq-list">{engagement.plaquette.points.map((x) => <li>{x}</li>)}</ul>
            <div class="al-plaq-f" data-plaquette-f>
              <input name="fn" placeholder="Ton prénom" autocomplete="given-name" required aria-label="Prénom" />
              <input name="em" type="email" placeholder="Ton email" autocomplete="email" required aria-label="Email" />
              <input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="al-hp" />
              <button type="submit" class="al-btn">{engagement.plaquette.btn}</button>
            </div>
            <a class="al-btn al-plaquette-dl" href={engagement.plaquette.file} download data-plaquette-dl hidden>Télécharger la plaquette (PDF)</a>
            <p class="al-note">{engagement.plaquette.fine}</p>
          </div>
        </form>
      </div>
    </section>

    <section id="simulateur" class="s59 al-sim-sec">
      <div class="s33">
        <div class="s28">{sim.label}</div>
        <h2 class="s34">{sim.h2a} <span class="s111">{sim.h2b}</span></h2>
        <p class="al-sim-intro">{sim.intro}</p>
        <div class="al-sim" data-sim>
          <div class="al-sim-top"><span data-sim="count">Question 1</span><div class="al-sim-bar"><i data-sim="bar"></i></div></div>
          <div data-sim-screen="q">
            <h3 class="al-sim-q" data-sim="q">{sim.questions[0].q}</h3>
            <div class="al-sim-opts" data-sim="opts"></div>
            <div class="al-sim-scales" data-sim="scales" hidden></div>
            <button type="button" class="al-btn al-sim-next" data-sim="next" hidden>Continuer</button>
            <button type="button" class="al-back" data-sim="back" hidden>← Question précédente</button>
          </div>
          <div data-sim-screen="gate" hidden>
            <div class="s227">{sim.scoreTitle}</div>
            <div class="al-score-n"><b data-sim="n"></b><span>sur 100</span></div>
            <p class="al-score-emo" data-sim="emo"></p>
            <div class="al-blur" aria-hidden="true">
              <div class="al-blur-in" data-sim="preview"></div>
              <div class="al-blur-lock">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                <b>Ton plan est prêt</b><span>Piliers, équipe, priorités et gains</span>
              </div>
            </div>
            <form data-sim="gate">
              <h3 class="al-sim-gate-h">{sim.gate.h}</h3>
              <p class="s229">{sim.gate.p}</p>
              <div class="al-fields">
                <label class="al-field">Prénom<input name="fn" autocomplete="given-name" placeholder="Camille" required /></label>
                <label class="al-field">Nom<input name="ln" autocomplete="family-name" placeholder="Martin" required /></label>
                <label class="al-field">Email<input name="em" type="email" autocomplete="email" placeholder="camille@monprojet.fr" required /></label>
                <label class="al-field">Téléphone <small>uniquement pour le rappel SMS si tu réserves un appel</small><input name="tel" type="tel" autocomplete="tel" placeholder="06 12 34 56 78" /></label>
                <input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="al-hp" />
              </div>
              <button type="submit" class="al-btn">{sim.gate.btn}</button>
              <p class="al-note">Pas de spam, pas de revente. Désinscription en un clic.</p>
            </form>
            <button type="button" class="al-back" data-sim="back2">← Question précédente</button>
          </div>
          <div data-sim-screen="res" hidden>
            <div class="s227">{sim.scoreTitle}</div>
            <div class="al-score-n al-score-n--sm"><b data-sim="n2"></b><span>sur 100</span></div>
            <div data-sim="gauges"></div>
            <div class="al-lever" data-sim="lever"></div>
            <h3 class="al-sim-plan-h" data-sim="planh"></h3>
            <div class="al-plan" data-sim="plan"></div>
            <a class="al-res-cta" href={url.reserverOuverture}><b>{sim.cta.label}</b><span>{sim.cta.sub}</span></a>
            <button type="button" class="al-back" data-sim="restart">Refaire le simulateur</button>
          </div>
        </div>
      </div>
    </section>
    <script is:inline define:vars={{ SIM: sim, GAINS: [...gains.ouverture, ...piliers] }}>
      (function () {
        var Q = SIM.questions, root = document.querySelector('[data-sim]');
        var $ = function (k) { return root.querySelector('[data-sim="' + k + '"]'); };
        var dl = function (o) { (window.dataLayer = window.dataLayer || []).push(o); };
        var st = { cur: Q[0].id, hist: [], ans: {}, started: false };
        var byId = function (id) { return Q.find(function (q) { return q.id === id; }); };
        var visible = function (q) { return !q.showIf || (st.ans[q.showIf.q] != null && q.showIf.in.indexOf(st.ans[q.showIf.q]) >= 0); };
        var asked = function () { return Q.filter(visible); };
        function nextId(id) { var i = Q.findIndex(function (q) { return q.id === id; }); for (var k = i + 1; k < Q.length; k++) if (visible(Q[k])) return Q[k].id; return 'gate'; }
        function el(t, c, x) { var e = document.createElement(t); if (c) e.className = c; if (x != null) e.textContent = x; return e; }
        function score() {
          var acc = {}; SIM.pillars.forEach(function (p) { acc[p.k] = [0, 0]; });
          Q.forEach(function (q) { if (q.p && visible(q) && st.ans[q.id] != null) { acc[q.p][0] += q.sc[st.ans[q.id]]; acc[q.p][1]++; } });
          var ps = SIM.pillars.filter(function (p) { return acc[p.k][1]; }).map(function (p) { return { p: p, v: Math.round(acc[p.k][0] / acc[p.k][1]) }; });
          var total = Math.round(ps.reduce(function (s, x) { return s + x.v; }, 0) / ps.length);
          var weak = ps.reduce(function (m, x) { return x.v < m.v ? x : m; }, ps[0]);
          var band = SIM.bands.find(function (b) { return total < b.max; });
          return { total: total, ps: ps, weak: weak, phrase: band.t };
        }
        var level = function (v) { return v >= 75 ? 'Solide' : v >= 40 ? 'En construction' : 'À travailler'; };
        function gauges(sc) {
          var box = el('div', 'al-gauges');
          sc.ps.forEach(function (x) {
            var row = el('div'), top = el('div', 'al-gauge-top'), tr = el('div', 'al-track'), bar = el('i', x === sc.weak ? 'weak' : '');
            top.appendChild(el('b', null, x.p.n)); top.appendChild(el('span', null, level(x.v)));
            tr.setAttribute('role', 'img'); tr.setAttribute('aria-label', x.p.n + ' : ' + x.v + ' sur 100');
            bar.style.width = Math.max(x.v, 4) + '%'; tr.appendChild(bar); row.appendChild(top); row.appendChild(tr); box.appendChild(row);
          });
          return box;
        }
        function lever(sc, t) { t.innerHTML = ''; t.hidden = sc.weak.v >= 75; t.appendChild(el('b', null, sc.weak.p.lever)); t.appendChild(el('p', null, sc.weak.p.txt)); }
        function plan(target) {
          target.innerHTML = '';
          var a = st.ans, q = function (id) { return byId(id); };
          var card = function (k, h, p) { var c = el('div', 'al-plan-c'); c.appendChild(el('div', 'al-plan-k', k)); c.appendChild(el('b', null, h)); if (p) c.appendChild(el('p', null, p)); target.appendChild(c); };
          // Équipe
          if (a.s5 === 0) card('Ton équipe', 'Tu démarres seul', 'On prépare avec toi ton premier recrutement, au bon moment.');
          else card('Ton équipe', q('s5').o[a.s5] + ' collaborateurs à recruter et former', a.s6 === 0 ? 'Déjà trouvés : on les forme à nos méthodes avant l\'ouverture.' : a.s6 === 1 ? 'Une partie est trouvée : on recrute le reste avec toi.' : 'On recrute avec toi, puis on les forme avant l\'ouverture.');
          // Priorités
          var sc = a.s7 || {}, list = q('s7').scales.slice().sort(function (x, y) { return (sc[y.k] || 0) - (sc[x.k] || 0); });
          card('Tes priorités d\'accompagnement', list.map(function (x, i) { return (i + 1) + '. ' + x.l + ' (' + (sc[x.k] || 0) + '/10)'; }).join('  ·  '), null);
          // Objectif
          card('Ton objectif', q('s8').o[a.s8] + ' au fauteuil par semaine · ' + q('s9').o[a.s9] + ' salon' + (a.s9 > 0 ? 's' : '') + ' à terme', a.s8 >= 2 ? 'Un salon qui tourne sans toi au fauteuil : on le construit dès l\'ouverture.' : null);
          // Gain mis en avant
          var g = GAINS.find(function (x) { return x.t === SIM.prioGain[list[0].k]; });
          if (g) card('Ce que tu gagnes en priorité', g.t, g.p);
          if (a.s2 === 1) { var c = el('div', 'al-plan-c'); c.appendChild(el('div', 'al-plan-k', 'Tu regardais une franchise')); var l = el('a', null, 'Compare point par point : franchise ou indépendant →'); l.href = '#franchise'; c.appendChild(l); target.appendChild(c); }
        }
        function show(k) { ['q', 'gate', 'res'].forEach(function (s) { root.querySelector('[data-sim-screen="' + s + '"]').hidden = s !== k; }); }
        function render() {
          var list = asked(), n = list.length;
          if (st.cur === 'gate' || st.cur === 'res') {
            var sc = score();
            $('count').textContent = st.cur === 'gate' ? 'Ton score' : 'Ton plan';
            $('bar').style.width = st.cur === 'gate' ? Math.round(n / (n + 1) * 100) + '%' : '100%';
            if (st.cur === 'gate') {
              $('n').textContent = sc.total; $('emo').textContent = sc.phrase;
              var pv = $('preview'); pv.innerHTML = ''; pv.appendChild(gauges(sc));
              var lv = el('div', 'al-lever'); lever(sc, lv); pv.appendChild(lv);
              show('gate');
            } else {
              $('n2').textContent = sc.total;
              var g = $('gauges'); g.innerHTML = ''; g.appendChild(gauges(sc));
              lever(sc, $('lever'));
              $('planh').textContent = (st.fn ? st.fn + ', voici' : 'Voici') + ' ton plan d\'ouverture';
              plan($('plan'));
              show('res');
            }
            return;
          }
          var cq = byId(st.cur), idx = list.indexOf(cq);
          $('count').textContent = 'Question ' + (idx + 1);
          $('bar').style.width = Math.round(idx / (n + 1) * 100) + '%';
          $('q').textContent = cq.q;
          var opts = $('opts'), scales = $('scales'), next = $('next');
          opts.innerHTML = ''; scales.innerHTML = '';
          if (cq.type === 'scales') {
            opts.hidden = true; scales.hidden = false; next.hidden = false;
            var cur = st.pick || (st.pick = Object.assign({}, st.ans[cq.id] || {}));
            cq.scales.forEach(function (s) {
              var row = el('div', 'al-scale'), lab = el('div', 'al-scale-l', s.l), dots = el('div', 'al-scale-dots');
              dots.setAttribute('role', 'radiogroup'); dots.setAttribute('aria-label', s.l);
              for (var v = 1; v <= 10; v++) {
                var b = el('button', 'al-scale-b' + (cur[s.k] === v ? ' on' : ''), String(v));
                b.type = 'button'; b.setAttribute('role', 'radio'); b.setAttribute('aria-checked', String(cur[s.k] === v));
                b.setAttribute('data-scale', s.k); b.setAttribute('data-v', v); dots.appendChild(b);
              }
              row.appendChild(lab); row.appendChild(dots); scales.appendChild(row);
            });
            next.disabled = cq.scales.some(function (s) { return !cur[s.k]; });
          } else {
            opts.hidden = false; scales.hidden = true; next.hidden = true;
            cq.o.forEach(function (label, i) {
              var b = el('button', 's231' + (st.ans[cq.id] === i ? ' al-on' : '')); b.type = 'button'; b.setAttribute('data-sim-opt', i);
              b.appendChild(el('span', 's232')); b.appendChild(document.createTextNode(label)); opts.appendChild(b);
            });
          }
          $('back').hidden = !st.hist.length;
          show('q');
        }
        function answer(v) {
          if (!st.started) { st.started = true; dl({ event: 'sim_start' }); }
          st.ans[st.cur] = v; st.pick = null;
          Q.forEach(function (q) { if (!visible(q)) delete st.ans[q.id]; });
          st.hist.push(st.cur); st.cur = nextId(st.cur); render();
        }
        root.addEventListener('click', function (e) {
          var o = e.target.closest('[data-sim-opt]'); if (o) { answer(+o.getAttribute('data-sim-opt')); return; }
          var sb = e.target.closest('[data-scale]'); if (sb) { st.pick[sb.getAttribute('data-scale')] = +sb.getAttribute('data-v'); render(); return; }
          if (e.target.closest('[data-sim="next"]')) { answer(Object.assign({}, st.pick)); return; }
          if (e.target.closest('[data-sim="back"]') || e.target.closest('[data-sim="back2"]')) { if (st.hist.length) { st.cur = st.hist.pop(); st.pick = null; render(); } return; }
          if (e.target.closest('[data-sim="restart"]')) { st = { cur: Q[0].id, hist: [], ans: {}, started: false }; render(); }
        });
        $('gate').addEventListener('submit', function (e) {
          e.preventDefault();
          var f = this.elements, sc = score();
          st.fn = (f.fn.value || '').trim();
          var lead = { fn: st.fn, ln: (f.ln.value || '').trim(), em: (f.em.value || '').trim(), tel: (f.tel.value || '').trim(), seg: 'OUVERTURE', contactId: '' };
          var utm = {}; try { utm = JSON.parse(sessionStorage.getItem('al_utm') || '{}'); } catch (err) {}
          var answers = [{ q: 'Origine', a: 'Simulateur page Ouvrir un salon' }];
          asked().forEach(function (q) {
            var a = st.ans[q.id]; if (a == null) return;
            answers.push({ q: q.q, a: q.type === 'scales' ? q.scales.map(function (s) { return s.l + ' ' + a[s.k] + '/10'; }).join(' · ') : q.o[a] });
          });
          answers.push({ q: 'Score', a: sc.total + ' / 100' });
          sc.ps.forEach(function (x) { answers.push({ q: 'Pilier ' + x.p.n, a: x.v + ' / 100' }); });
          var save = function () { try { sessionStorage.setItem('al_diag', JSON.stringify(lead)); } catch (err) {} };
          save();
          fetch('/api/formation/lead', { method: 'POST', keepalive: true, headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fn: lead.fn, ln: lead.ln, em: lead.em, tel: lead.tel, segment: 'OUVERTURE', answers: answers, utm: utm, page: location.href, website: f.website.value })
          }).then(function (r) { return r.json(); }).then(function (d) { if (d && d.contactId) { lead.contactId = d.contactId; save(); } }).catch(function () {});
          dl({ event: 'lead_submit', form: 'simulateur-ouverture', segment: 'OUVERTURE' });
          dl({ event: 'sim_complete', score: sc.total });
          st.hist.push('gate'); st.cur = 'res'; render();
          root.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        render();
      })();
      // Plaquette : prénom + email (envoyés à GoHighLevel), puis lien de téléchargement
      (function () {
        var f = document.querySelector('[data-plaquette]'); if (!f) return;
        f.addEventListener('submit', function (e) {
          e.preventDefault();
          var x = f.elements;
          fetch('/api/formation/lead', { method: 'POST', keepalive: true, headers: { 'Content-Type': 'application/json' },
