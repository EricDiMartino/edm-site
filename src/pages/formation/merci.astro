---
// ACADEMY LEADER — Merci (/formation/merci), noindex. Écran de la maquette.
// Prénom + créneau lus depuis /reserver (sessionStorage) ; à terme, depuis la redirection GoHighLevel.
// Vidéo Xavier, étude de cas et boutons « ajouter à l'agenda » retirés tant que les contenus n'existent pas (22/10/2026).
import FormationLayout from '../../components/formation/FormationLayout.astro';
import { tunnelSeo, merciTodo } from '../../data/formation/tunnel';
import { url } from '../../data/formation/site';
---

<FormationLayout title={tunnelSeo.merci.title} noindex bare>
  <main class="s233">
    <div class="s234"><a href={url.accueil} class="s223" style="color:#F8F4ED">Academy <span class="s5">Leader</span></a></div>
    <div class="s260">
      <div class="s261">✓ Rendez-vous confirmé</div>
      <h1 class="s262" data-m="title">C'est confirmé.</h1>
      <p class="s263" data-m="when"></p>
      <div class="s265">
        {merciTodo.map((m) => <div class="s266"><div class="s227">{m.n}</div><b class="s267">{m.t}</b><p class="s268">{m.p}</p></div>)}
      </div>
    </div>
  </main>

  <script is:inline>
    (function () {
      var r = {}; try { r = JSON.parse(sessionStorage.getItem('al_rdv') || '{}'); } catch (e) {}
      document.querySelector('[data-m="title"]').textContent = r.fn ? "C'est confirmé, " + r.fn + '.' : "C'est confirmé.";
      document.querySelector('[data-m="when"]').textContent = r.when ? r.when + ' à ' + r.slot + ' · 30 min en visio avec Xavier Paolucci' : '30 min en visio avec Xavier Paolucci · le détail est dans l\'email de confirmation';
      // Conversion seulement après une vraie réservation (al_rdv posé par /reserver), une seule fois
      if (r.when) { (window.dataLayer = window.dataLayer || []).push({ event: 'rdv_confirme' }); try { sessionStorage.removeItem('al_rdv'); } catch (e) {} }
    })();
  </script>
</FormationLayout>
