---
// Layout de base — <head> commun + système de design + reveal au scroll.
// noindex par défaut (pré-lancement) ; passer noindex={false} à la bascule (Phase 6).
// Polices auto-hébergées (RGPD : plus d'appel au CDN Google ; bundlées par Astro).
import '@fontsource-variable/fraunces/opsz.css'; // axes opsz + wght (normal)
import '@fontsource-variable/fraunces/opsz-italic.css'; // + italique
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '../styles/system.css';
import BookingModal from './BookingModal.astro';
import ConsentBanner from './ConsentBanner.astro';
import ConsentHead from './ConsentHead.astro';
import FormHandler from './FormHandler.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}
const { title, description, canonical, ogImage, ogType = 'website', noindex = false } = Astro.props;
// Image de partage : celle de la page si fournie, sinon visuel de marque par défaut.
const ogImageUrl = ogImage || (Astro.site ? new URL('/og-default.jpg', Astro.site).href : '/og-default.jpg');
// Tag Manager — conteneur neuf dédié au site (surchargeable via PUBLIC_GTM_ID).
// Mettre '' pour désactiver complètement la couche tracking.
const gtmId = import.meta.env.PUBLIC_GTM_ID || 'GTM-MHHC3VXC';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ConsentHead gtmId={gtmId} storageKey="edm_consent" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Eric Di Martino" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    {gtmId && <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />}
    <slot />
    <BookingModal />
    <ConsentBanner />
    <FormHandler />
    {/* Événements de conversion → dataLayer (GTM déclenche GA4 / Ads / Meta / TikTok dessus). */}
    <script is:inline>
      addEventListener('click', function (e) {
        var r = e.target.closest && e.target.closest('a[href="#reserver"], [data-reserve]');
        if (r) (window.dataLayer = window.dataLayer || []).push({ event: 'reserve_click', location: location.pathname });
      });
      addEventListener('submit', function (e) {
        var f = e.target;
        // les forms [data-sheet-form] poussent leur propre event (voir FormHandler) → on les ignore ici
        if (f && f.matches && f.matches('form:not([data-sheet-form])')) {
          (window.dataLayer = window.dataLayer || []).push({ event: 'lead_submit', form: f.id || f.getAttribute('name') || 'form', location: location.pathname });
        }
      }, true);
    </script>
    <script is:inline>
      document.documentElement.classList.add("js");
      addEventListener("DOMContentLoaded", function () {
        var els = document.querySelectorAll(".reveal");
        var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!("IntersectionObserver" in window) || reduce) {
          els.forEach(function (e) { e.classList.add("is-in"); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add("is-in"); io.unobserve(en.target); }
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
        els.forEach(function (e) { io.observe(e); });
      });
    </script>
  </body>
</html>
