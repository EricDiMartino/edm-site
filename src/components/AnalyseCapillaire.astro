---
// Section RÉUTILISABLE « Analyse capillaire » — contenu : src/data/analyse-capillaire.ts.
// Positionnement diagnostic expert (jamais produit).
// Doses via `variant` :
//   - courte   : bandeau COMPACT (accroche + lien) — accueil / LP / head spa (léger, n'allonge pas la page)
//   - moyenne  : bloc FUSIONNÉ consultation + analyse, 4 bénéfices, DOUBLE photo (pages salon) ← salon
//   - complete : + « comment ça marche » + suivi dans le temps (page consultation)
// Props : `reverse` (côté visuel, moyenne/complete) · `ville` (localisation lede moyenne) ·
//         `consultationImage` (photo principale de la double photo, moyenne) · `dark` (palette sombre, ex. head spa).
import { Image } from 'astro:assets';
import { analyseCapillaire as ac } from '../data/analyse-capillaire';
import type { ImageMetadata } from 'astro';

interface Props {
  variant?: 'courte' | 'moyenne' | 'complete';
  reverse?: boolean;
  ville?: string;
  consultationImage?: ImageMetadata;
  dark?: boolean;
  ctaHref?: string; // surcharge du lien CTA (ex. '#reserver' sur la page consultation)
  ctaLabel?: string;
}
const { variant = 'moyenne', reverse = false, ville, consultationImage, dark = false, ctaHref, ctaLabel } = Astro.props;

const isMoyenne = variant === 'moyenne';
const hasVideo = !!ac.video;
// La vidéo (Eric explique) remplace le « comment ça marche » + le suivi rédigé.
const showEtapes = variant === 'complete' && !hasVideo;
const showSuivi = variant === 'complete' && !hasVideo;

// moyenne = bloc fusionné consultation ; courte/complete = analyse seule.
const eyebrow = isMoyenne ? ac.salon.eyebrow : ac.eyebrow;
const titre = isMoyenne ? ac.salon.titre : ac.titre;
const lede = isMoyenne ? ac.salon.lede.replace('{ville}', ville ?? 'nos salons') : ac.lede;
const benefices = isMoyenne ? ac.salon.benefices : ac.benefices;
const cta = { href: ctaHref ?? (isMoyenne ? ac.salon.cta.href : ac.cta.href), label: ctaLabel ?? (isMoyenne ? ac.salon.cta.label : ac.cta.label) };
---

<section class:list={['ac', `ac--${variant}`, { 'ac--reverse': reverse, 'ac--dark': dark }]}>
  {variant === 'courte' ? (
    <div class="ac-band">
      <p class="label">{ac.eyebrow}</p>
      <p class="ac-band-txt">{ac.accroche}</p>
      <a class="link-arrow link-olive ac-link" href={ac.cta.href}>{ac.cta.label}<span class="arrow" aria-hidden="true">→</span></a>
    </div>
  ) : (
    <div class="ac-inner">
      <div class="ac-visual reveal">
        {hasVideo ? (
          <figure class="ac-frame ac-video" data-ac-video>
            <video preload="none" playsinline poster={ac.video!.poster}>
              <source src={ac.video!.src} type="video/mp4" />
            </video>
            <button type="button" class="ac-play" aria-label="Lire la vidéo">
              <span class="ac-play-ring"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
            </button>
          </figure>
        ) : isMoyenne ? (
          <div class="ac-duo">
            <figure class="ac-frame ac-frame--main">
              {consultationImage ? (
                <Image src={consultationImage} widths={[420, 640, 860]} sizes="(min-width: 820px) 42vw, 90vw" alt={`La consultation au salon${ville ? ' de ' + ville : ''}`} loading="lazy" />
              ) : (
                <div class="ac-ph"><span>Consultation</span></div>
              )}
            </figure>
            <figure class="ac-frame ac-frame--inset">
              {ac.image ? (
                <Image src={ac.image} widths={[240, 360, 480]} sizes="(min-width: 820px) 20vw, 45vw" alt={ac.imageAlt} loading="lazy" />
              ) : (
                <div class="ac-ph ac-ph--sm">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M11 7v8M7 11h8" opacity="0.4" /><path d="m20 20-3.5-3.5" /></svg>
                  <span>Analyse capillaire</span>
                </div>
              )}
            </figure>
          </div>
        ) : (
          <figure class="ac-frame">
            {ac.image ? (
              <Image src={ac.image} widths={[480, 720, 960]} sizes="(min-width: 820px) 48vw, 100vw" alt={ac.imageAlt} loading="lazy" />
            ) : (
              <div class="ac-ph">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M11 7v8M7 11h8" opacity="0.4" /><path d="m20 20-3.5-3.5" /></svg>
                <span>Analyse capillaire</span>
              </div>
            )}
          </figure>
        )}
      </div>

      <div class="ac-copy reveal" data-d="1">
        <p class="label">{eyebrow}</p>
        <h2 class="h-seo">{titre}</h2>
        <p class="body ac-lede">{lede}</p>

        {showEtapes && (
          <ol class="ac-steps">
            {ac.etapes.map((e) => (
              <li>
                <span class="ac-step-num">{e.num}</span>
                <div><p class="ac-step-titre">{e.titre}</p><p class="ac-step-texte">{e.texte}</p></div>
              </li>
            ))}
          </ol>
        )}

        <ul class="ac-benefits">
          {benefices.map((b) => (
            <li><span class="ac-bene-titre">{b.titre}</span><span class="ac-bene-texte">{b.texte}</span></li>
          ))}
        </ul>

        {showSuivi && <p class="body ac-suivi">{ac.suivi}</p>}

        <a class="btn btn-action ac-cta" href={cta.href}>{cta.label}</a>
      </div>
    </div>
  )}
</section>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-ac-video]').forEach(function (fig) {
      var v = fig.querySelector('video'), b = fig.querySelector('.ac-play');
      if (!v || !b) return;
      b.addEventListener('click', function () {
        v.setAttribute('controls', '');
        fig.classList.add('is-playing');
        var p = v.play();
        if (p && p.catch) p.catch(function () {});
      });
    });
  })();
</script>

<style>
  .ac { max-width: var(--maxw); margin-inline: auto; padding: var(--section-y) var(--gutter); }
  .ac-inner { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; }

  /* Bandeau compact (courte) */
  .ac--courte { padding-block: clamp(2.5rem, 5vw, 3.75rem); }
  .ac-band { max-width: 44rem; margin-inline: auto; text-align: center; }
  .ac-band-txt { font-family: var(--serif); font-size: clamp(1.3rem, 1.05rem + 1.1vw, 1.9rem); line-height: 1.28; color: var(--ink); margin: 0.9rem 0 0; }
  .ac-band .ac-link { margin-top: 1.3rem; justify-content: center; }

  /* Visuel simple (complète) */
  .ac-frame { position: relative; aspect-ratio: 4 / 3; margin: 0; border-radius: var(--radius); overflow: hidden; box-shadow: inset 0 0 0 1px var(--line); }
  .ac-frame :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .ac-ph { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.9rem; color: var(--olive); background: linear-gradient(150deg, var(--cream), var(--cream-deep)); }
  .ac-ph svg { width: 42px; height: 42px; opacity: 0.55; }
  .ac-ph span { font-family: var(--sans); font-weight: 600; font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.75; }
  .ac-ph--sm svg { width: 30px; height: 30px; }
  .ac-ph--sm span { font-size: 0.6rem; }

  /* Vidéo (clic pour lire) — visuel portrait */
  .ac-video { aspect-ratio: 4 / 5; }
  .ac-video video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .ac-play { position: absolute; inset: 0; display: grid; place-items: center; border: 0; cursor: pointer; background: linear-gradient(180deg, rgba(20, 16, 11, 0.12), rgba(20, 16, 11, 0.42)); transition: opacity 0.3s, background-color 0.25s; }
  .ac-play:hover { background: linear-gradient(180deg, rgba(20, 16, 11, 0.22), rgba(20, 16, 11, 0.5)); }
  .ac-play-ring { display: grid; place-items: center; width: clamp(3.75rem, 6vw, 4.75rem); height: clamp(3.75rem, 6vw, 4.75rem); border-radius: 50%; background: var(--terracotta); box-shadow: 0 12px 30px -10px rgba(42, 35, 29, 0.6); transition: transform 0.3s var(--ease), background-color 0.25s; }
  .ac-play:hover .ac-play-ring { transform: scale(1.06); background: var(--terracotta-deep); }
  .ac-play-ring svg { width: 42%; height: 42%; margin-left: 8%; color: #fff; }
  .ac-video.is-playing .ac-play { opacity: 0; pointer-events: none; }

  /* Double photo (moyenne) */
  .ac-duo { position: relative; padding-bottom: 2.2rem; padding-right: 2.2rem; }
  .ac-duo .ac-frame--main { aspect-ratio: 4 / 3; }
  .ac-duo .ac-frame--inset { position: absolute; right: 0; bottom: 0; width: 48%; aspect-ratio: 4 / 3; border: 6px solid var(--bg); border-radius: calc(var(--radius) + 4px); box-shadow: 0 18px 40px -22px rgba(42, 35, 29, 0.5); }

  /* Copie */
  .ac-lede { margin-top: 1rem; max-width: 46ch; }
  .ac-benefits { list-style: none; margin: 1.7rem 0 0; padding: 0; display: grid; gap: 1rem 1.5rem; }
  .ac-benefits li { position: relative; padding-left: 1.6rem; }
  .ac-benefits li::before { content: ""; position: absolute; left: 3px; top: 0.35rem; width: 6px; height: 11px; border-right: 1.7px solid var(--terracotta); border-bottom: 1.7px solid var(--terracotta); transform: rotate(45deg); }
  .ac-bene-titre { display: block; font-family: var(--serif); font-size: 1.08rem; color: var(--ink); margin-bottom: 0.15rem; }
  .ac-bene-texte { display: block; font-size: 0.9rem; line-height: 1.5; color: var(--muted); }

  .ac-steps { list-style: none; margin: 1.7rem 0 0; padding: 0; display: grid; gap: 1.15rem; }
  .ac-steps li { display: flex; gap: 1rem; }
  .ac-step-num { font-family: var(--serif); font-size: 1.2rem; color: var(--terracotta); flex: none; line-height: 1.2; }
  .ac-step-titre { font-family: var(--serif); font-size: 1.08rem; color: var(--ink); margin: 0 0 0.2rem; }
  .ac-step-texte { font-size: 0.9rem; line-height: 1.5; color: var(--muted); margin: 0; }

  .ac-suivi { margin-top: 1.3rem; max-width: 52ch; }
  .ac-cta { margin-top: 1.9rem; }
  .ac-link { display: inline-flex; }

  /* ===== Variante sombre (ex. head spa) ===== */
  .ac--dark :global(.label) { color: #cf9d72; }
  .ac--dark .ac-band-txt { color: #fdfbf7; }
  .ac--dark :global(.h-seo) { color: #fdfbf7; }
  .ac--dark .ac-lede, .ac--dark .ac-bene-texte, .ac--dark .ac-step-texte { color: rgba(247, 243, 234, 0.6); }
  .ac--dark .ac-bene-titre, .ac--dark .ac-step-titre { color: #fdfbf7; }
  .ac--dark .ac-benefits li::before { border-color: #cf9d72; }
  .ac--dark .ac-step-num { color: #cf9d72; }
  .ac--dark .ac-link { color: #cf9d72; }

  @media (min-width: 820px) {
    .ac-inner { grid-template-columns: 1fr 1fr; }
    .ac--reverse .ac-visual { order: 2; }
  }
  @media (min-width: 560px) {
    .ac--moyenne .ac-benefits, .ac--complete .ac-benefits { grid-template-columns: 1fr 1fr; }
  }
</style>
