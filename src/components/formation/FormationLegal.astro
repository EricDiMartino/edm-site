---
// Gabarit des pages légales Academy Leader (mentions, CGV, confidentialité, informations Qualiopi).
// Le contenu est écrit en HTML dans chaque page (slot). Classes : .al-legal-page (formation.css).
import FormationLayout from './FormationLayout.astro';
interface Props { title: string; h1: string; eyebrow: string; maj: string; description?: string; noindex?: boolean }
const { title, h1, eyebrow, maj, description, noindex = false } = Astro.props;
---

<FormationLayout title={title} description={description} noindex={noindex}>
  <main class="al-legal-page">
    <div class="al-wrap">
      <div class="s28">{eyebrow}</div>
      <h1>{h1}</h1>
      <p class="al-maj">Dernière mise à jour : {maj}</p>
      <slot />
    </div>
  </main>
</FormationLayout>
