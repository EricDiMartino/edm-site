---
// Layout Academy Leader (/formation/*) — charte propre (formation.css), SANS system.css ni Planity.
// Partagé avec les salons : ConsentHead (Consent Mode v2 + GTM) et ConsentBanner, paramétrés
// pour EDXP Formation (clé de consentement et conteneur GTM distincts : autre entité juridique).
import '../../styles/formation.css';
import fontLatin from '../../assets/formation/fonts/instrument-sans-latin.woff2?url';
import ConsentHead from '../ConsentHead.astro';
import ConsentBanner from '../ConsentBanner.astro';
import FormationHeader from './FormationHeader.astro';
import FormationFooter from './FormationFooter.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** masque header/footer (écrans de tunnel sans sortie : diagnostic) */
  bare?: boolean;
}
const { title, description, noindex = false, bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Conteneur GTM Academy Leader (compte « EDXP Formation », ≠ GTM salons). Surchargeable via PUBLIC_GTM_ID_FORMATION.
const gtmId = import.meta.env.PUBLIC_GTM_ID_FORMATION || 'GTM-WT68LQZP';
// <noscript> GTM exclu des déploiements non-production (cf. Layout.astro). Le script GTM est déjà
// gaté par hostname dans ConsentHead (partagé) → aucun GTM hors prod.
const isPreviewDeploy = !!process.env.VERCEL_ENV && process.env.VERCEL_ENV !== 'production';
// Image de partage 1200×630 : les 3 associés (public/og-academy-leader.jpg).
const ogImageUrl = new URL('/og-academy-leader.jpg', Astro.site).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ConsentHead gtmId={gtmId} storageKey="al_consent" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="preload" as="font" type="font/woff2" href={fontLatin} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Academy Leader" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0F0C0A" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    {gtmId && !isPreviewDeploy && <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />}
    {!bare && <FormationHeader />}
    <slot />
    {!bare && <FormationFooter />}
    <ConsentBanner storageKey="al_consent" infoHref="/formation/confidentialite" />
    <script is:inline>
      // Mémorise les paramètres de campagne (utm_*, gclid, fbclid) de la 1re page vue → envoyés à GHL avec le diagnostic.
      try {
        var q = new URLSearchParams(location.search), u = {};
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'fbclid'].forEach(function (k) { if (q.get(k)) u[k] = q.get(k); });
        if (Object.keys(u).length) sessionStorage.setItem('al_utm', JSON.stringify(u));
      } catch (e) {}
    </script>
  </body>
</html>
