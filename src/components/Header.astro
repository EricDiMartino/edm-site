---
// En-tête / navigation — site-wide, réutilisable.
// Comportement résa dynamique :
//  - pages salon / expertise : tél du salon + lien de résa direct (props tel + reservationUrl)
//  - pages neutres : pas de tél ; bouton « Réserver » → menu déroulant des salons (prop salons)
interface SalonLink { ville: string; href: string }
interface Props {
  tel?: string; // affiché + cliquable si fourni
  reservationUrl?: string; // résa directe (pages salon/expertise)
  salons?: SalonLink[]; // pages neutres → dropdown
  current?: string; // clé de l'onglet actif
}
const { tel, reservationUrl, salons = [], current } = Astro.props;
const telHref = tel ? 'tel:' + tel.replace(/[^0-9+]/g, '') : '';

const NAV = [
  { label: 'Salons', href: '/nos-salons-de-coiffure', key: 'salons' },
  { label: 'Prestations', href: '/prestations-coiffure', key: 'prestations' },
  { label: 'Head spa', href: '/head-spa-grenoble', key: 'headspa' },
  { label: 'Notre histoire', href: '/nos-valeurs', key: 'histoire' },
  { label: 'Blog', href: '/actualites', key: 'blog' },
  { label: 'Carrières', href: '/nous-rejoindre', key: 'carrieres' },
];
---

<header class="site-header">
  <a class="brand" href="/">
    <span class="brand-name">Eric&nbsp;Di&nbsp;Martino</span>
    <span class="brand-sub">Salon de coiffure</span>
  </a>

  <nav class="nav" aria-label="Navigation principale">
    {NAV.map((item) => (
      <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>

  <div class="nav-actions">
    {telHref && <a class="nav-tel" href={telHref}>{tel}</a>}
    {reservationUrl ? (
      <a class="btn btn-action btn-sm" href={reservationUrl}>Réserver</a>
    ) : (
      <details class="resa-menu">
        <summary class="btn btn-action btn-sm">Réserver</summary>
        <ul class="resa-list">
          {salons.map((s) => (
            <li><a href={s.href}>{s.ville}</a></li>
          ))}
        </ul>
      </details>
    )}
    <details class="m-menu">
      <summary class="m-toggle" aria-label="Ouvrir le menu"><span class="burger" aria-hidden="true"></span></summary>
      <nav class="m-nav" aria-label="Menu">
        {NAV.map((item) => (
          <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>

{(telHref || reservationUrl) && (
  <div class="m-actionbar">
    {telHref && (
      <a class="m-act m-act-call" href={telHref}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.14.38 2.35.58 3.6.58a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.58 3.6a1 1 0 0 1-.25 1z" /></svg>
        Appeler
      </a>
    )}
    {reservationUrl && <a class="m-act m-act-book" href={reservationUrl}>Réserver</a>}
  </div>
)}

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding: 1rem var(--gutter);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .brand { text-decoration: none; color: var(--ink); line-height: 1; flex: none; }
  .brand-name { display: block; font-family: var(--serif); font-size: 1.15rem; }
  .brand-sub { display: block; margin-top: 0.3rem; font-family: var(--sans); font-weight: 500; font-size: 0.56rem; letter-spacing: 0.26em; text-transform: uppercase; color: var(--olive); }
  .nav { display: none; }
  .nav-actions { display: flex; align-items: center; gap: 1.1rem; }
  .nav-tel { display: none; font-family: var(--sans); font-size: 0.84rem; color: var(--ink); text-decoration: none; }
  .nav-tel:hover { color: var(--olive); }

  /* Dropdown résa (pages neutres) — <details>, sans JS */
  .resa-menu { position: relative; }
  .resa-menu > summary { list-style: none; cursor: pointer; }
  .resa-menu > summary::-webkit-details-marker { display: none; }
  .resa-list {
    position: absolute; right: 0; top: calc(100% + 0.5rem); z-index: 60;
    min-width: 14rem; margin: 0; padding: 0.5rem; list-style: none;
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: 0 20px 40px -20px rgba(38, 38, 31, 0.3);
  }
  .resa-list a {
    display: block; padding: 0.6rem 0.8rem; text-decoration: none; color: var(--ink);
    font-family: var(--sans); font-size: 0.9rem; border-radius: var(--radius);
  }
  .resa-list a:hover { background: var(--cream); color: var(--olive); }

  /* Menu mobile (hamburger, <details>, zéro JS) */
  .m-menu { position: static; }
  .m-toggle { list-style: none; cursor: pointer; display: inline-flex; align-items: center; padding: 0.5rem; margin: -0.5rem; }
  .m-toggle::-webkit-details-marker { display: none; }
  .burger { position: relative; display: block; width: 22px; height: 1.5px; background: var(--ink); transition: background 0.2s; }
  .burger::before, .burger::after { content: ""; position: absolute; left: 0; width: 22px; height: 1.5px; background: var(--ink); transition: transform 0.3s var(--ease); }
  .burger::before { top: -6px; }
  .burger::after { top: 6px; }
  .m-menu[open] .burger { background: transparent; }
  .m-menu[open] .burger::before { transform: translateY(6px) rotate(45deg); }
  .m-menu[open] .burger::after { transform: translateY(-6px) rotate(-45deg); }
  .m-nav {
    position: absolute; left: 0; right: 0; top: 100%; z-index: 60;
    display: flex; flex-direction: column;
    padding: 0.5rem var(--gutter) 1.25rem;
    background: #fff; border-bottom: 1px solid var(--line);
    box-shadow: 0 22px 32px -26px rgba(38, 38, 31, 0.35);
  }
  .m-nav a {
    font-family: var(--sans); font-weight: 500; font-size: 0.98rem; color: var(--ink);
    text-decoration: none; padding: 0.75rem 0; border-bottom: 1px solid var(--line);
  }
  .m-nav a:last-child { border-bottom: 0; }
  .m-nav a[aria-current="page"] { color: var(--olive); }

  /* Barre d'action fixe mobile (Appeler + Réserver) */
  .nav-actions > .btn-action, .nav-actions > .resa-menu { display: none; } /* Réserver retiré du header en mobile */
  .m-actionbar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 70;
    display: flex; gap: 0.6rem;
    padding: 0.6rem var(--gutter) calc(0.6rem + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.94); backdrop-filter: saturate(140%) blur(10px);
    border-top: 1px solid var(--line);
  }
  .m-act {
    flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    font-family: var(--sans); font-weight: 500; font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 0.95rem; border-radius: var(--radius); text-decoration: none;
  }
  .m-act svg { width: 15px; height: 15px; }
  .m-act-call { background: #fff; color: var(--ink); border: 1px solid var(--line); }
  .m-act-book { background: var(--terracotta); color: #fff; }
  :global(body) { padding-bottom: 4.75rem; } /* place pour la barre fixe */

  @media (min-width: 820px) {
    .m-menu { display: none; }
    .m-actionbar { display: none; }
    .nav-actions > .btn-action, .nav-actions > .resa-menu { display: inline-flex; }
    :global(body) { padding-bottom: 0; }
    .site-header { display: grid; grid-template-columns: auto 1fr auto; gap: 2rem; }
    .nav { display: flex; justify-content: center; flex-wrap: wrap; gap: clamp(0.9rem, 2.1vw, 2.1rem); }
    .nav a {
      font-family: var(--sans); font-weight: 500; font-size: 0.8rem; letter-spacing: 0.02em;
      text-decoration: none; color: var(--ink); border-bottom: 1px solid transparent;
      padding-bottom: 3px; transition: color 0.3s, border-color 0.3s;
    }
    .nav a:hover { color: var(--olive); }
    .nav a[aria-current="page"] { color: var(--olive); border-color: var(--olive); }
    .nav-tel { display: inline-block; }
  }
</style>
