---
// En-tête / navigation — site-wide, réutilisable.
// Comportement résa dynamique :
//  - pages salon / expertise : tél du salon + lien de résa direct (props tel + reservationUrl)
//  - pages neutres : pas de tél ; bouton « Réserver » → menu déroulant des salons (prop salons)
interface SalonLink { ville: string; href: string }
interface Props {
  tel?: string; // affiché + cliquable si fourni
  reservationUrl?: string; // résa directe (pages salon/expertise)
  salons?: SalonLink[]; // pages neutres → dropdown
  current?: string; // clé de l'onglet actif
  reserveKey?: string; // clé Planity → ouvre la modale sur ce salon (ex. beauté du regard = Montbonnot)
  reserveCat?: string; // filtre serviceSetsWhitelist appliqué à la modale
}
const { tel, reservationUrl, salons = [], current, reserveKey, reserveCat } = Astro.props;
const telHref = tel ? 'tel:' + tel.replace(/[^0-9+]/g, '') : '';

// Liste des salons (menu « Salons » + dropdown résa des pages neutres).
const SALONS: SalonLink[] = [
  { ville: 'Grenoble', href: '/salon-de-coiffure/grenoble' },
  { ville: 'Montbonnot', href: '/salon-de-coiffure/montbonnot' },
  { ville: 'Voiron', href: '/salon-de-coiffure/voiron' },
  { ville: 'Aix-les-Bains', href: '/salon-de-coiffure/aix-les-bains' },
];

const NAV = [
  {
    label: 'Salons', href: '/nos-salons-de-coiffure', key: 'salons',
    drop: { items: SALONS.map((s) => ({ label: s.ville, href: s.href })), all: { label: 'Tous nos salons', href: '/nos-salons-de-coiffure' } },
  },
  {
    label: 'Prestations', href: '/prestations-coiffure', key: 'prestations',
    active: ['prestations', 'headspa', 'beauteregard'],
    drop: {
      items: [
        { label: 'Head spa', href: '/head-spa-grenoble', sub: 'Grenoble' },
        { label: 'Beauté du regard', href: '/beaute-du-regard-montbonnot', sub: 'Montbonnot' },
      ],
      all: { label: 'Toutes les prestations', href: '/prestations-coiffure' },
      allFirst: true,
    },
  },
  { label: 'Nos valeurs', href: '/nos-valeurs', key: 'histoire' },
  { label: 'Blog', href: '/actualites', key: 'blog' },
  { label: 'Carrières', href: '/nous-rejoindre', key: 'carrieres' },
];
---

<header class="site-header">
  <a class="brand" href="/">
    <span class="brand-name">Eric&nbsp;Di&nbsp;Martino</span>
    <span class="brand-sub">Salon de coiffure</span>
  </a>

  <nav class="nav" aria-label="Navigation principale">
    {NAV.map((item) => (item.drop ? (
      <div class="nav-drop">
        <a href={item.href} class="nav-drop-trigger" aria-current={(item.active ?? [item.key]).includes(current ?? '') ? 'page' : undefined} aria-haspopup="true">{item.label}<span class="caret" aria-hidden="true"></span></a>
        <div class="nav-drop-panel">
          {item.drop.all && item.drop.allFirst && (
            <Fragment>
              <a class="nav-drop-lead" href={item.drop.all.href}>{item.drop.all.label}<span class="nav-drop-allarrow" aria-hidden="true">→</span></a>
              <span class="nav-drop-sep" aria-hidden="true"></span>
            </Fragment>
          )}
          <ul class="nav-drop-list">
            {item.drop.items.map((it) => (
              <li><a href={it.href}><span class="nav-drop-label">{it.label}</span>{it.sub && <span class="nav-drop-sub">{it.sub}</span>}</a></li>
            ))}
          </ul>
          {item.drop.all && !item.drop.allFirst && (
            <a class="nav-drop-all" href={item.drop.all.href}>{item.drop.all.label}<span class="nav-drop-allarrow" aria-hidden="true">→</span></a>
          )}
        </div>
      </div>
    ) : (
      <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
    )))}
  </nav>

  <div class="nav-actions">
    {telHref && <a class="nav-tel" href={telHref}>{tel}</a>}
    {reservationUrl ? (
      <a class="btn btn-action btn-sm" href={reservationUrl} data-planity={reserveKey} data-cat={reserveCat}>Réserver</a>
    ) : (
      <details class="resa-menu">
        <summary class="btn btn-action btn-sm">Réserver</summary>
        <ul class="resa-list">
          {salons.map((s) => (
            <li><a href={s.href}>{s.ville}</a></li>
          ))}
        </ul>
      </details>
    )}
    <details class="m-menu">
      <summary class="m-toggle" aria-label="Ouvrir le menu"><span class="burger" aria-hidden="true"></span></summary>
      <nav class="m-nav" aria-label="Menu">
        {NAV.map((item) => (item.drop ? (
          <div class="m-group">
            <a class="m-group-label" href={item.href} aria-current={(item.active ?? [item.key]).includes(current ?? '') ? 'page' : undefined}>{item.label}</a>
            {item.drop.items.map((it) => (<a class="m-sub" href={it.href}>{it.label}</a>))}
          </div>
        ) : (
          <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
        )))}
      </nav>
    </details>
  </div>
</header>

{(telHref || reservationUrl || salons.length > 0) && (
  <div class="m-actionbar">
    {telHref && (
      <a class="m-act m-act-call" href={telHref}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.14.38 2.35.58 3.6.58a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.58 3.6a1 1 0 0 1-.25 1z" /></svg>
        Appeler
      </a>
    )}
    {reservationUrl ? (
      <a class="m-act m-act-book" href={reservationUrl} data-planity={reserveKey} data-cat={reserveCat}>Réserver</a>
    ) : (
      <a class="m-act m-act-book" href="#reserver" data-reserve>Réserver</a>
    )}
  </div>
)}

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding: 1rem var(--gutter);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .brand { text-decoration: none; color: var(--ink); line-height: 1; flex: none; }
  .brand-name { display: block; font-family: var(--serif); font-size: 1.15rem; }
  .brand-sub { display: block; margin-top: 0.3rem; font-family: var(--sans); font-weight: 500; font-size: 0.56rem; letter-spacing: 0.26em; text-transform: uppercase; color: var(--olive); }
  .nav { display: none; }
  .nav-actions { display: flex; align-items: center; gap: 1.1rem; }
  .nav-tel { display: none; font-family: var(--sans); font-size: 0.84rem; color: var(--ink); text-decoration: none; }
  .nav-tel:hover { color: var(--olive); }

  /* Dropdown résa (pages neutres) — <details>, sans JS */
  .resa-menu { position: relative; }
  .resa-menu > summary { list-style: none; cursor: pointer; }
  .resa-menu > summary::-webkit-details-marker { display: none; }
  .resa-list {
    position: absolute; right: 0; top: calc(100% + 0.5rem); z-index: 60;
    min-width: 14rem; margin: 0; padding: 0.5rem; list-style: none;
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: 0 20px 40px -20px rgba(38, 38, 31, 0.3);
  }
  .resa-list a {
    display: block; padding: 0.6rem 0.8rem; text-decoration: none; color: var(--ink);
    font-family: var(--sans); font-size: 0.9rem; border-radius: var(--radius);
  }
  .resa-list a:hover { background: var(--cream); color: var(--olive); }

  /* Menu mobile (hamburger, <details>, zéro JS) */
  .m-menu { position: static; }
  .m-toggle { list-style: none; cursor: pointer; display: inline-flex; align-items: center; padding: 0.5rem; margin: -0.5rem; }
  .m-toggle::-webkit-details-marker { display: none; }
  .burger { position: relative; display: block; width: 22px; height: 1.5px; background: var(--ink); transition: background 0.2s; }
  .burger::before, .burger::after { content: ""; position: absolute; left: 0; width: 22px; height: 1.5px; background: var(--ink); transition: transform 0.3s var(--ease); }
  .burger::before { top: -6px; }
  .burger::after { top: 6px; }
  .m-menu[open] .burger { background: transparent; }
  .m-menu[open] .burger::before { transform: translateY(6px) rotate(45deg); }
  .m-menu[open] .burger::after { transform: translateY(-6px) rotate(-45deg); }
  .m-nav {
    position: absolute; left: 0; right: 0; top: 100%; z-index: 60;
    display: flex; flex-direction: column;
    padding: 0.5rem var(--gutter) 1.25rem;
    background: #fff; border-bottom: 1px solid var(--line);
    box-shadow: 0 22px 32px -26px rgba(38, 38, 31, 0.35);
  }
  .m-nav a {
    font-family: var(--sans); font-weight: 500; font-size: 0.98rem; color: var(--ink);
    text-decoration: none; padding: 0.75rem 0; border-bottom: 1px solid var(--line);
  }
  .m-nav a:last-child { border-bottom: 0; }
  .m-nav a[aria-current="page"] { color: var(--olive); }
  /* Groupe « Salons » dans le menu mobile */
  .m-group { padding: 0.75rem 0; border-bottom: 1px solid var(--line); }
  .m-group-label { display: block; font-family: var(--sans); font-weight: 600; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--olive); margin-bottom: 0.35rem; text-decoration: none; }
  .m-sub { display: block; font-family: var(--sans); font-weight: 500; font-size: 0.98rem; color: var(--ink); text-decoration: none; padding: 0.45rem 0 0.45rem 0.9rem; }

  /* Barre d'action fixe mobile (Appeler + Réserver) */
  .nav-actions > .btn-action, .nav-actions > .resa-menu { display: none; } /* Réserver retiré du header en mobile */
  .m-actionbar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 70;
    display: flex; gap: 0.6rem;
    padding: 0.6rem var(--gutter) calc(0.6rem + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.94); backdrop-filter: saturate(140%) blur(10px);
    border-top: 1px solid var(--line);
  }
  .m-act {
    flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    font-family: var(--sans); font-weight: 500; font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 0.95rem; border-radius: var(--radius); text-decoration: none;
  }
  .m-act svg { width: 15px; height: 15px; }
  .m-act-call { background: #fff; color: var(--ink); border: 1px solid var(--line); }
  .m-act-book { background: var(--terracotta); color: #fff; }
  :global(body) { padding-bottom: 4.75rem; } /* place pour la barre fixe */

  @media (min-width: 820px) {
    .m-menu { display: none; }
    .m-actionbar { display: none; }
    .nav-actions > .btn-action, .nav-actions > .resa-menu { display: inline-flex; }
    :global(body) { padding-bottom: 0; }
    /* 1fr auto 1fr → la nav est centrée sur la PAGE (et non entre logo et actions) */
    .site-header { display: grid; grid-template-columns: 1fr auto 1fr; gap: 2rem; }
    .nav-actions { justify-self: end; }
    .nav { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: clamp(0.9rem, 2.1vw, 2.1rem); }
    .nav a {
      font-family: var(--sans); font-weight: 500; font-size: 0.8rem; letter-spacing: 0.02em;
      text-decoration: none; color: var(--ink); border-bottom: 1px solid transparent;
      padding-bottom: 3px; transition: color 0.3s, border-color 0.3s;
    }
    .nav a:hover { color: var(--olive); }
    .nav a[aria-current="page"] { color: var(--olive); border-color: var(--olive); }
    .nav-tel { display: inline-block; }

    /* Menu déroulant « Salons » (desktop) — survol + clavier (focus-within), sans JS */
    .nav-drop { position: relative; display: inline-flex; align-items: center; }
    .nav-drop-trigger {
      display: inline-flex; align-items: center; cursor: pointer; text-decoration: none;
      font-family: var(--sans); font-weight: 500; font-size: 0.8rem; letter-spacing: 0.02em;
      color: var(--ink); background: none; border: 0; border-bottom: 1px solid transparent;
      padding: 0 0 3px; transition: color 0.3s, border-color 0.3s;
    }
    .caret {
      width: 0; height: 0; margin-left: 0.4rem;
      border-left: 3.5px solid transparent; border-right: 3.5px solid transparent;
      border-top: 4px solid currentColor; opacity: 0.7;
      transition: transform 0.3s var(--ease);
    }
    .nav-drop:hover .nav-drop-trigger, .nav-drop-trigger:focus-visible { color: var(--olive); }
    .nav-drop-trigger[aria-current="page"] { color: var(--olive); border-color: var(--olive); }
    .nav-drop:hover .caret, .nav-drop:focus-within .caret { transform: rotate(180deg); }

    .nav-drop-panel {
      position: absolute; left: 50%; top: 100%; margin-top: 0.8rem; z-index: 60;
      min-width: 13rem; padding: 0.4rem;
      background: #fff; border: 1px solid var(--line); border-radius: 12px;
      box-shadow: 0 14px 36px -22px rgba(38, 38, 31, 0.26);
      opacity: 0; visibility: hidden; pointer-events: none;
      transform: translateX(-50%) translateY(6px);
      transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0.2s;
    }
    .nav-drop-panel::before { content: ""; position: absolute; left: 0; right: 0; top: -0.8rem; height: 0.8rem; } /* pont anti-hover-gap */
    .nav-drop:hover .nav-drop-panel, .nav-drop:focus-within .nav-drop-panel {
      opacity: 1; visibility: visible; pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
    .nav-drop-list { list-style: none; margin: 0; padding: 0; }
    .nav-drop-list a {
      display: flex; flex-direction: column; gap: 0.12rem;
      padding: 0.58rem 0.7rem; text-decoration: none; color: var(--ink);
      border-radius: 8px; transition: background-color 0.2s, color 0.2s;
    }
    .nav-drop-list a:hover { background: var(--cream); color: var(--olive); }
    .nav-drop-label { font-family: var(--sans); font-weight: 500; font-size: 0.88rem; letter-spacing: 0.01em; }
    .nav-drop-sub { font-family: var(--sans); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
    .nav-drop-all {
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      margin-top: 0.3rem; padding: 0.62rem 0.7rem; border-top: 1px solid var(--line);
      font-family: var(--sans); font-weight: 600; font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--olive); text-decoration: none;
    }
    .nav-drop-allarrow { transition: transform 0.25s var(--ease); }
    .nav-drop-all:hover { color: var(--olive-deep); }
    .nav-drop-all:hover .nav-drop-allarrow { transform: translateX(3px); }

    /* « all » en tête (ex. Toutes les prestations) : entrée principale du menu */
    .nav-drop-lead {
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      padding: 0.62rem 0.7rem; border-radius: 8px; text-decoration: none;
      font-family: var(--sans); font-weight: 600; font-size: 0.9rem; letter-spacing: 0.01em;
      color: var(--olive); transition: background-color 0.2s, color 0.2s;
    }
    .nav-drop-lead:hover { background: var(--cream); color: var(--olive-deep); }
    .nav-drop-lead .nav-drop-allarrow { color: var(--olive); }
    .nav-drop-lead:hover .nav-drop-allarrow { transform: translateX(3px); }
    .nav-drop-sep { display: block; height: 1px; background: var(--line); margin: 0.3rem 0.45rem; }
  }
</style>
