---
// Page salon — DESIGN V2 (HTML/CSS conservé tel quel).
// Le contenu vient en prop `salon` (src/data/<ville>.ts), séparé du design.
// Images optimisées au build via astro:assets (responsive + WebP/AVIF) — remplace
// l'ancien service d'images Storyblok, on garde le gain CWV.
import { Image } from 'astro:assets';
import Header from './Header.astro';
import type { SalonData } from '../data/grenoble';

interface Props {
  salon: SalonData;
}
const { salon } = Astro.props;

// Largeurs responsive par emplacement (capées sous la taille source → pas d'upscale).
const HERO_WIDTHS = [640, 960, 1280, 1696];
const SPLIT_WIDTHS = [480, 768];
const PORTRAIT_WIDTHS = [240, 360, 480];

const heroH1 = salon.titreSeo || (salon.ville ? `Salon de coiffure à ${salon.ville}` : salon.nom);
const telHref = salon.telephone ? 'tel:' + salon.telephone.replace(/[^0-9+]/g, '') : '';
const cpVille = [salon.codePostal, salon.ville].filter(Boolean).join(' ');

const showNap = !!(salon.adresse || salon.telephone || salon.horaires?.length || salon.mapsUrl);
const showExpertise = !!(salon.expertise && (salon.expertise.titre || salon.expertise.texte || salon.expertise.image));
const showMaison = !!(salon.maison && salon.maison.paragraphes?.length);
const showServices = (salon.services?.length ?? 0) > 0;
const showEquipe = (salon.equipe?.length ?? 0) > 0;
const showFaq = (salon.faq?.length ?? 0) > 0;
const showChiffres = (salon.chiffres?.length ?? 0) > 0;
const showAcces = (salon.acces?.length ?? 0) > 0;
const showCitation = !!(salon.citation && salon.citation.texte);
const showAvis = !!(salon.avis && salon.avis.items?.length);
const showInstagram = !!(salon.instagram && salon.instagram.url);
const showPrestations = !!(salon.prestations && salon.prestations.items?.length);

// Icônes filaires (trait terracotta) pour la grille de prestations.
const PREST_ICONS: Record<string, string> = {
  extensions: '<path d="M7 4c0 6-2 10 0 16"/><path d="M12 4c0 6 2 10 0 16"/><path d="M17 4c0 6-2 10 0 16"/>',
  mariage: '<circle cx="9.5" cy="14.5" r="5.5"/><circle cx="14.5" cy="14.5" r="5.5"/>',
  coaching: '<path d="M12 3l1.9 5.6L20 10l-6.1 1.4L12 17l-1.9-5.6L4 10l6.1-1.4z"/>',
  soin: '<path d="M12 3s6 6 6 11a6 6 0 0 1-12 0c0-5 6-11 6-11z"/>',
};
---

<div class="salon-page" data-planity={salon.planityKey}>
  <Header tel={salon.telephone} reservationUrl={salon.reservationUrl} current="salons" />

  <main id="top">
    <!-- 1. HERO -->
    <section class="hero">
      <div class="hero-copy reveal">
        {salon.ville && <p class="label">Salon de coiffure · {salon.ville}</p>}
        {salon.accroche && <p class="editorial hero-editorial">{salon.accroche}</p>}
        <h1 class="h-seo hero-h1">{heroH1}</h1>
        {salon.heroTexte && <p class="lede hero-lede">{salon.heroTexte}</p>}
        <div class="hero-actions">
          <a class="btn btn-action" href={salon.reservationUrl}>Réserver une visite</a>
          <a class="btn btn-ghost btn-video" href="#salon" aria-label="Découvrir le salon en vidéo">
            <svg class="play-ico" width="11" height="11" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
            Découvrir le salon
          </a>
        </div>
      </div>
      <div class="hero-visual reveal" data-d="1">
        <div class="frame frame-tall">
          <Image
            src={salon.heroImage}
            widths={HERO_WIDTHS}
            sizes="(min-width: 820px) 58vw, 100vw"
            alt={`Salon Eric Di Martino — ${salon.ville}`}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <!-- 1b. CHIFFRES-CLÉS (réassurance) -->
    {showChiffres && (
      <section class="stats">
        <ul class="stats-grid reveal">
          {salon.chiffres!.map((c) => (
            <li class="stat">
              <span class="stat-value">{c.valeur}</span>
              <span class="stat-label">{c.label}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- 2. INFOS PRATIQUES (NAP) -->
    {showNap && (
      <section class="nap-wrap" id="salon">
        <div class="nap reveal">
          <div class="nap-block nap-a">
            <p class="label">Le salon</p>
            {salon.adresse && <p class="nap-line">{salon.adresse}</p>}
            {cpVille && <p class="nap-line">{cpVille}</p>}
            {salon.mapsUrl && <a class="link-olive" href={salon.mapsUrl} aria-label="Ouvrir l'itinéraire dans Google Maps">Itinéraire &rsaquo;</a>}
            {showAcces && (
              <ul class="acces" aria-label="Accès">
                {salon.acces!.map((a) => (
                  <li class="acces-badge" title={a.detail}>{a.label}</li>
                ))}
              </ul>
            )}
          </div>
          {salon.horaires.length > 0 && (
            <div class="nap-block nap-b">
              <p class="label">Horaires</p>
              <ul class="hours">
                {salon.horaires.map((h) => (
                  <li class={h.ferme ? 'is-closed' : ''}><span>{h.jour}</span><span>{h.valeur}</span></li>
                ))}
              </ul>
            </div>
          )}
          <div class="nap-block nap-c">
            <p class="label">Réservation</p>
            <p class="nap-line">Sur rendez-vous</p>
            {telHref && <a class="phone" href={telHref}>{salon.telephone}</a>}
            <a class="btn btn-action btn-sm nap-cta" href={salon.reservationUrl}>Réserver en ligne</a>
          </div>
        </div>
      </section>
    )}

    <!-- 3. EXPERTISE VISAGISTE -->
    {showExpertise && (
      <section class="split">
        <div class="split-visual reveal">
          <div class="frame">
            {salon.expertise!.image && (
              <Image
                src={salon.expertise!.image}
                widths={SPLIT_WIDTHS}
                sizes="(min-width: 820px) 48vw, 100vw"
                alt="L’espace consultation du salon"
                loading="lazy"
              />
            )}
          </div>
        </div>
        <div class="split-copy reveal" data-d="1">
          <p class="label">Notre signature</p>
          {salon.expertise!.titre && <h2 class="h-seo">{salon.expertise!.titre}</h2>}
          {salon.expertise!.texte && <p class="body">{salon.expertise!.texte}</p>}
          {salon.expertise!.lien && <a class="link-olive" href={salon.expertise!.lien}>Découvrir la consultation &rsaquo;</a>}
        </div>
      </section>
    )}

    <!-- 5. SERVICES PHARES (layout alterné ; sombre = esprit cocon, plus riche) -->
    {showServices && salon.services.map((s, i) => {
      const reverse = i % 2 === 1;
      const content = (
        <Fragment>
          <div class="split-visual reveal">
            <div class={`frame frame-wide ${s.sombre ? 'frame-dark' : ''}`}>
              {s.image && (
                <Image
                  src={s.image}
                  widths={SPLIT_WIDTHS}
                  sizes="(min-width: 820px) 48vw, 100vw"
                  alt={s.titre}
                  loading="lazy"
                />
              )}
              {s.prix && (
                <div class="price-badge">
                  <span class="price-amount">{s.prix}</span>
                  {s.prixDetail && <span class="price-detail">{s.prixDetail}</span>}
                </div>
              )}
            </div>
          </div>
          <div class="split-copy reveal" data-d="1">
            {s.eyebrow && <p class={`label ${s.sombre ? 'label-light' : ''}`}>{s.eyebrow}</p>}
            {s.titre && (s.sombre
              ? <h2 class="h-seo" set:html={s.titre.replace(/ à (.+)$/, ' à&nbsp;<em>$1</em>')} />
              : <h2 class="h-seo">{s.titre}</h2>
            )}
            {s.texte && <p class={`body ${s.sombre ? 'body-light' : ''}`}>{s.texte}</p>}
            {s.points && s.points.length > 0 && (
              <ul class="points">
                {s.points.map((p) => <li>{p}</li>)}
              </ul>
            )}
            {s.lien && (
              <a class={`link-arrow ${s.sombre ? 'link-cream' : 'link-olive'}`} href={s.lien}>
                {s.lienLabel || 'En savoir plus'}<span class="arrow" aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </Fragment>
      );
      return s.sombre ? (
        <section class="service-dark">
          <div class={`split ${reverse ? 'reverse' : ''}`}>{content}</div>
        </section>
      ) : (
        <section class={`split ${reverse ? 'reverse' : ''}`}>{content}</section>
      );
    })}

    <!-- 5bis. PRESTATIONS COMPLÉMENTAIRES (grille) -->
    {showPrestations && (
      <section class="section prestations">
        <header class="prest-head reveal">
          {salon.prestations!.eyebrow && <p class="label">{salon.prestations!.eyebrow}</p>}
          <h2 class="h-seo">{salon.prestations!.titre}{salon.prestations!.titreEm && (<Fragment> <em>{salon.prestations!.titreEm}</em></Fragment>)}</h2>
          {salon.prestations!.texte && <p class="lede prest-lede">{salon.prestations!.texte}</p>}
        </header>
        <div class="prest-grid reveal" data-d="1">
          {salon.prestations!.items.map((p) => (
            <article class="prest-card">
              <svg class="prest-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={PREST_ICONS[p.icon ?? 'soin'] ?? PREST_ICONS.soin} />
              <h3 class="prest-title">{p.titre}</h3>
              <p class="prest-text">{p.texte}</p>
              {p.caption && <Fragment><span class="prest-div" aria-hidden="true"></span><p class="prest-cap">{p.caption}</p></Fragment>}
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- 5a. NOTRE MAISON (à propos local — SEO/GEO) -->
    {showMaison && (
      <section class="section maison">
        <div class="maison-copy reveal">
          <p class="label">{salon.maison!.eyebrow}</p>
          <h2 class="h-seo">{salon.maison!.titre}</h2>
          {salon.maison!.paragraphes.map((p) => <p class="body maison-p">{p}</p>)}
          {salon.maison!.lien && (
            <a class="link-arrow link-olive" href={salon.maison!.lien.href}>
              {salon.maison!.lien.label}<span class="arrow" aria-hidden="true">→</span>
            </a>
          )}
        </div>
        <div class="maison-map reveal" data-d="1">
          <iframe
            title={`Carte — ${salon.nom}, ${salon.ville}`}
            src={`https://www.google.com/maps?q=${encodeURIComponent([salon.adresse, salon.codePostal, salon.ville].filter(Boolean).join(', '))}&z=16&output=embed`}
            width="100%"
            height="100%"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </section>
    )}

    <!-- 5b. CITATION SIGNATURE -->
    {showCitation && (
      <section class="signature">
        <blockquote class="reveal">
          <p class="signature-quote">{salon.citation!.texte}</p>
          <p class="signature-author">{salon.citation!.auteur}</p>
        </blockquote>
      </section>
    )}

    <!-- 6. ÉQUIPE — grands portraits ronds ; masquée si vide -->
    {showEquipe && (
      <section class="section team">
        <header class="section-head reveal">
          <p class="label">L'équipe</p>
          <h2 class="h-seo">{salon.equipeTitre || `L'équipe${salon.ville ? ' de ' + salon.ville : ''}`}</h2>
        </header>
        <ul class="team-grid">
          {salon.equipe.map((m) => {
            const photo = m.photo ?? salon.equipePlaceholder;
            return (
              <li class="team-card reveal">
                <div class="portrait">
                  {photo && (
                    <Image
                      src={photo}
                      widths={PORTRAIT_WIDTHS}
                      sizes="(min-width: 1000px) 18vw, (min-width: 820px) 30vw, 45vw"
                      alt={`${m.prenom}${m.specialite ? ', ' + m.specialite : ''} — Eric Di Martino ${salon.ville}`}
                      loading="lazy"
                    />
                  )}
                </div>
                <p class="team-name">{m.prenom}</p>
                {m.specialite && <p class="team-role">{m.specialite}</p>}
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <!-- 6b. AVIS (placeholder — vrais avis Google à brancher) -->
    {showAvis && (
      <section class="section reviews">
        <header class="section-head reveal">
          <p class="label">Avis</p>
          <h2 class="h-seo">Ils en parlent mieux que nous</h2>
          <p class="reviews-rating">
            <span class="g-mark" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 48 48"><path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/><path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/><path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/><path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/></svg></span>
            <strong>{salon.avis!.note}</strong> / 5 · {salon.avis!.total} avis {salon.avis!.source}
          </p>
          <p class="reviews-filter"><span class="reviews-pill">5★ · les plus récents</span></p>
        </header>
        <ul class="reviews-grid">
          {salon.avis!.items.map((a) => {
            const note = Math.round(a.rating ?? 5);
            return (
              <li class="review-card reveal">
                <div class="review-top">
                  <span class="review-avatar" aria-hidden="true">{a.auteur.charAt(0)}</span>
                  <span class="review-meta">
                    <span class="review-name">{a.auteur}</span>
                    {a.detail && <span class="review-date">{a.detail}</span>}
                  </span>
                </div>
                <span class="review-stars" aria-label={`${note} sur 5`}>{'★'.repeat(note)}<span class="star-empty">{'★'.repeat(5 - note)}</span></span>
                <p class="review-text">{a.texte}</p>
                {salon.avis!.url && <a class="review-link" href={salon.avis!.url} target="_blank" rel="noopener">Lire sur Google &rsaquo;</a>}
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <!-- 6c. INSTAGRAM (galerie statique + lien profil ; sameAs dans le schema) -->
    {showInstagram && (
      <section class="section instagram">
        <header class="section-head reveal">
          <p class="label">Sur Instagram</p>
          <h2 class="h-seo">Le salon{salon.ville ? ` de ${salon.ville}` : ''} en images</h2>
        </header>
        <ul class="ig-grid reveal" data-d="1">
          {Array.from({ length: 6 }).map(() => (
            <li>
              <a class="ig-shot" href={salon.instagram!.url} target="_blank" rel="noopener" aria-label={`Voir ${salon.instagram!.handle} sur Instagram`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" /></svg>
              </a>
            </li>
          ))}
        </ul>
        <p class="ig-follow reveal">
          <a class="link-arrow link-olive" href={salon.instagram!.url} target="_blank" rel="noopener">Suivre {salon.instagram!.handle}<span class="arrow" aria-hidden="true">→</span></a>
        </p>
      </section>
    )}

    <!-- 7. CTA FINAL -->
    <section class="section cta" id="reserver">
      <div class="cta-inner reveal">
        <p class="editorial cta-title">{salon.ctaTitre || 'Offrez-vous un vrai moment.'}</p>
        {salon.ville && <p class="lede cta-lede">Réservez votre visite à {salon.ville}. Consultation comprise, sans supplément.</p>}
        <a class="btn btn-action btn-lg" href={salon.reservationUrl}>Réserver en ligne</a>
        {telHref && <p class="cta-phone">ou par téléphone — <a href={telHref}>{salon.telephone}</a></p>}
      </div>
    </section>

    <!-- 8. FAQ -->
    {showFaq && (
      <section class="section faq">
        <header class="section-head reveal">
          <p class="label">FAQ</p>
          <h2 class="h-seo">Questions fréquentes</h2>
        </header>
        <div class="faq-list reveal" data-d="1">
          {salon.faq.map((item) => (
            <details class="faq-item">
              <summary>{item.question}<span class="faq-plus" aria-hidden="true"></span></summary>
              {item.reponse && <div class="rt"><p>{item.reponse}</p></div>}
            </details>
          ))}
        </div>
      </section>
    )}
  </main>

  <footer class="site-footer">
    <div class="footer-grid">
      <div>
        <p class="footer-mark">Eric Di Martino</p>
        {salon.ville && <p class="footer-sub">{salon.ville}</p>}
      </div>
      <div class="footer-meta">
        {(salon.adresse || cpVille) && <p>{[salon.adresse, cpVille].filter(Boolean).join(', ')}</p>}
        <p>Sur rendez-vous</p>
        {telHref && <p><a href={telHref}>{salon.telephone}</a></p>}
      </div>
    </div>
  </footer>
</div>

<style is:global>
  /* Fondation (tokens, base, typo, .section, boutons/liens, cadres, motion, eyebrows)
     → src/styles/system.css (importé par Layout.astro). Ici : styles SPÉCIFIQUES à la page salon. */

  .hero-visual:hover .frame,
  .split-visual:hover .frame { transform: scale(1.015); }

  /* ============ 1. HERO ============ */
  .hero {
    max-width: var(--maxw); margin-inline: auto;
    padding: clamp(2rem, 6vw, 3.5rem) var(--gutter) var(--section-y);
    display: grid; gap: clamp(2.25rem, 6vw, 3.5rem);
  }
  .hero-copy { align-self: center; }
  .hero-editorial { margin-bottom: 1.1rem; }
  .hero-h1 { color: var(--muted); font-weight: 380; max-width: 26ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.75rem; }

  /* ============ 2. NAP ============ */
  .nap-wrap { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .nap { max-width: var(--maxw); margin-inline: auto; padding: var(--section-y) var(--gutter); display: grid; gap: clamp(2rem, 5vw, 3rem); }
  .nap-line { margin: 0.15rem 0; font-size: 1.06rem; }
  .hours li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid var(--line); font-size: 0.98rem; }
  .hours li:last-child { border-bottom: 0; }
  .hours .is-closed { color: var(--muted); }
  .phone { display: block; margin: 0.3rem 0 1.3rem; font-family: var(--serif); font-size: 1.5rem; color: var(--ink); text-decoration: none; }
  .nap-cta { display: inline-flex; }

  /* ============ 1b. CHIFFRES-CLÉS (réassurance) ============ */
  .stats { max-width: var(--maxw); margin-inline: auto; padding: clamp(2.5rem, 5vw, 3.75rem) var(--gutter); border-bottom: 1px solid var(--line); }
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.25rem, 4vw, 2.5rem); }
  .stat { text-align: center; }
  .stat-value { display: block; font-family: var(--serif); font-weight: 380; font-size: clamp(2rem, 1.3rem + 2.6vw, 3.1rem); line-height: 1; color: var(--ink); }
  .stat-label { display: block; margin-top: 0.55rem; font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }

  /* ============ BADGES D'ACCÈS (NAP) ============ */
  .acces { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 1.1rem; }
  .acces-badge {
    font-family: var(--sans); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.04em;
    color: var(--olive-deep); background: var(--cream);
    border: 1px solid var(--line); border-radius: 999px; padding: 0.35rem 0.75rem;
  }

  /* ============ 3 & 5. SPLIT ============ */
  .split { max-width: var(--maxw); margin-inline: auto; padding: var(--section-y) var(--gutter); display: grid; gap: clamp(2rem, 5vw, 3.5rem); align-items: center; }
  .split-copy { align-self: center; }

  /* ============ SERVICE SOMBRE (plein cadre, esprit cocon) ============ */
  .service-dark { background: var(--espresso); color: var(--cream); }
  .service-dark .h-seo { color: rgba(247, 243, 234, 0.92); }
  .service-dark .h-seo em { color: #d8a98a; }
  .service-dark .body { color: rgba(247, 243, 234, 0.82); }
  .frame-dark {
    background:
      radial-gradient(120% 90% at 80% 10%, rgba(189, 106, 76, 0.28), transparent 55%),
      linear-gradient(150deg, #3a302a 0%, #2a231d 60%, #1d1813 100%);
    box-shadow: inset 0 0 0 1px var(--line-light);
  }
  /* Service enrichi (liste de points, badge prix, lien fléché) */
  .points { display: grid; grid-template-columns: 1fr 1fr; gap: 0.55rem 1.5rem; margin: 1.6rem 0 2rem; max-width: 30rem; }
  .points li { position: relative; padding-left: 1.3rem; font-size: 0.92rem; color: inherit; }
  .points li::before { content: "—"; position: absolute; left: 0; opacity: 0.55; }
  .price-badge {
    position: absolute; top: 0; right: 0; z-index: 2;
    background: var(--cream); color: var(--ink);
    padding: 0.85rem 1.2rem; text-align: center;
  }
  .price-amount { display: block; font-family: var(--serif); font-size: 1.55rem; line-height: 1; }
  .price-detail { display: block; margin-top: 0.3rem; font-size: 0.58rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  /* ============ PRESTATIONS COMPLÉMENTAIRES (grille) ============ */
