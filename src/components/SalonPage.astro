---
// Page salon — DESIGN V2 (HTML/CSS conservé tel quel).
// Le contenu vient en prop `salon` (src/data/<ville>.ts), séparé du design.
// Images optimisées au build via astro:assets (responsive + WebP/AVIF) — remplace
// l'ancien service d'images Storyblok, on garde le gain CWV.
import { Image } from 'astro:assets';
import type { SalonData } from '../data/grenoble';

interface Props {
  salon: SalonData;
}
const { salon } = Astro.props;

// Largeurs responsive par emplacement (capées sous la taille source → pas d'upscale).
const HERO_WIDTHS = [640, 960, 1280, 1696];
const SPLIT_WIDTHS = [480, 768];
const AVATAR_WIDTHS = [200, 300, 400];

const heroH1 = salon.titreSeo || (salon.ville ? `Salon de coiffure à ${salon.ville}` : salon.nom);
const telHref = salon.telephone ? 'tel:' + salon.telephone.replace(/[^0-9+]/g, '') : '';
const cpVille = [salon.codePostal, salon.ville].filter(Boolean).join(' ');

const showNap = !!(salon.adresse || salon.telephone || salon.horaires?.length || salon.mapsUrl);
const showExpertise = !!(salon.expertise && (salon.expertise.titre || salon.expertise.texte || salon.expertise.image));
const showIntro = !!salon.introLocale;
const showServices = (salon.services?.length ?? 0) > 0;
const showEquipe = (salon.equipe?.length ?? 0) > 0;
const showFaq = (salon.faq?.length ?? 0) > 0;
---

<div class="salon-page">
  <header class="site-header">
    <a class="wordmark" href="#top">
      Eric&nbsp;Di&nbsp;Martino
      {salon.ville && <span class="wordmark-sub">{salon.ville}</span>}
    </a>
    <a class="btn btn-action btn-sm" href={salon.reservationUrl}>Réserver</a>
  </header>

  <main id="top">
    <!-- 1. HERO -->
    <section class="hero">
      <div class="hero-copy reveal">
        {salon.ville && <p class="label">Salon de coiffure · {salon.ville}</p>}
        {salon.accroche && <p class="editorial hero-editorial">{salon.accroche}</p>}
        <h1 class="h-seo hero-h1">{heroH1}</h1>
        {salon.heroTexte && <p class="lede hero-lede">{salon.heroTexte}</p>}
        <div class="hero-actions">
          <a class="btn btn-action" href={salon.reservationUrl}>Réserver une visite</a>
          <a class="btn btn-ghost" href="#salon">Découvrir le salon</a>
        </div>
      </div>
      <div class="hero-visual reveal" data-d="1">
        <div class="frame frame-tall">
          <Image
            src={salon.heroImage}
            widths={HERO_WIDTHS}
            sizes="(min-width: 820px) 58vw, 100vw"
            alt={`Salon Eric Di Martino — ${salon.ville}`}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <!-- 2. INFOS PRATIQUES (NAP) -->
    {showNap && (
      <section class="nap-wrap" id="salon">
        <div class="nap reveal">
          <div class="nap-block nap-a">
            <p class="label">Le salon</p>
            {salon.adresse && <p class="nap-line">{salon.adresse}</p>}
            {cpVille && <p class="nap-line">{cpVille}</p>}
            {salon.mapsUrl && <a class="link-olive" href={salon.mapsUrl} aria-label="Ouvrir l'itinéraire dans Google Maps">Itinéraire &rsaquo;</a>}
          </div>
          {salon.horaires.length > 0 && (
            <div class="nap-block nap-b">
              <p class="label">Horaires</p>
              <ul class="hours">
                {salon.horaires.map((h) => (
                  <li class={h.ferme ? 'is-closed' : ''}><span>{h.jour}</span><span>{h.valeur}</span></li>
                ))}
              </ul>
            </div>
          )}
          <div class="nap-block nap-c">
            <p class="label">Réservation</p>
            <p class="nap-line">Sur rendez-vous</p>
            {telHref && <a class="phone" href={telHref}>{salon.telephone}</a>}
            <a class="btn btn-action btn-sm nap-cta" href={salon.reservationUrl}>Réserver en ligne</a>
          </div>
        </div>
      </section>
    )}

    <!-- 3. EXPERTISE VISAGISTE -->
    {showExpertise && (
      <section class="split">
        <div class="split-visual reveal">
          <div class="frame">
            {salon.expertise!.image && (
              <Image
                src={salon.expertise!.image}
                widths={SPLIT_WIDTHS}
                sizes="(min-width: 820px) 48vw, 100vw"
                alt="L’espace consultation du salon"
                loading="lazy"
              />
            )}
          </div>
        </div>
        <div class="split-copy reveal" data-d="1">
          <p class="label">Notre signature</p>
          {salon.expertise!.titre && <h2 class="h-seo">{salon.expertise!.titre}</h2>}
          {salon.expertise!.texte && <p class="body">{salon.expertise!.texte}</p>}
          {salon.expertise!.lien && <a class="link-olive" href={salon.expertise!.lien}>Découvrir la consultation &rsaquo;</a>}
        </div>
      </section>
    )}

    <!-- 4. INTRO LOCALE -->
    {showIntro && (
      <section class="intro-locale">
        <p class="intro-text reveal">{salon.introLocale}</p>
      </section>
    )}

    <!-- 5. SERVICES PHARES (layout alterné ; sombre = esprit cocon) -->
    {showServices && salon.services.map((s, i) => {
      const reverse = i % 2 === 1;
      const content = (
        <Fragment>
          <div class="split-visual reveal">
            <div class={`frame frame-wide ${s.sombre ? 'frame-dark' : ''}`}>
              {s.image && (
                <Image
                  src={s.image}
                  widths={SPLIT_WIDTHS}
                  sizes="(min-width: 820px) 48vw, 100vw"
                  alt={s.titre}
                  loading="lazy"
                />
              )}
            </div>
          </div>
          <div class="split-copy reveal" data-d="1">
            {s.titre && <h2 class="h-seo">{s.titre}</h2>}
            {s.texte && <p class="body">{s.texte}</p>}
            {s.lien && <a class={s.sombre ? 'link-cream' : 'link-olive'} href={s.lien}>En savoir plus &rsaquo;</a>}
          </div>
        </Fragment>
      );
      return s.sombre ? (
        <section class="service-dark">
          <div class={`split ${reverse ? 'reverse' : ''}`}>{content}</div>
        </section>
      ) : (
        <section class={`split ${reverse ? 'reverse' : ''}`}>{content}</section>
      );
    })}

    <!-- 6. ÉQUIPE — grands portraits ronds ; masquée si vide -->
    {showEquipe && (
      <section class="section team">
        <header class="section-head reveal">
          <p class="label">L'équipe</p>
          <h2 class="h-seo">{salon.equipeTitre || `L'équipe${salon.ville ? ' de ' + salon.ville : ''}`}</h2>
        </header>
        <ul class="team-grid">
          {salon.equipe.map((m) => (
            <li class="team-card reveal">
              <div class="avatar">
                {m.photo ? (
                  <Image src={m.photo} widths={AVATAR_WIDTHS} sizes="200px" alt={m.prenom} loading="lazy" />
                ) : (
                  <span class="avatar-initial" aria-hidden="true">{m.prenom.charAt(0)}</span>
                )}
              </div>
              <p class="team-name">{m.prenom}</p>
              {m.specialite && <p class="team-role">{m.specialite}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- 7. CTA FINAL -->
    <section class="section cta" id="reserver">
      <div class="cta-inner reveal">
        <p class="editorial cta-title">{salon.ctaTitre || 'Offrez-vous un vrai moment.'}</p>
        {salon.ville && <p class="lede cta-lede">Réservez votre visite à {salon.ville}. Consultation comprise, sans supplément.</p>}
        <a class="btn btn-action btn-lg" href={salon.reservationUrl}>Réserver en ligne</a>
        {telHref && <p class="cta-phone">ou par téléphone — <a href={telHref}>{salon.telephone}</a></p>}
      </div>
    </section>

    <!-- 8. FAQ -->
    {showFaq && (
      <section class="section faq">
        <header class="section-head reveal">
          <p class="label">FAQ</p>
          <h2 class="h-seo">Questions fréquentes</h2>
        </header>
        <div class="faq-list reveal" data-d="1">
          {salon.faq.map((item) => (
            <details class="faq-item">
              <summary>{item.question}<span class="faq-plus" aria-hidden="true"></span></summary>
              {item.reponse && <div class="rt"><p>{item.reponse}</p></div>}
            </details>
          ))}
        </div>
      </section>
    )}
  </main>

  <footer class="site-footer">
    <div class="footer-grid">
      <div>
        <p class="footer-mark">Eric Di Martino</p>
        {salon.ville && <p class="footer-sub">{salon.ville}</p>}
      </div>
      <div class="footer-meta">
        {(salon.adresse || cpVille) && <p>{[salon.adresse, cpVille].filter(Boolean).join(', ')}</p>}
        <p>Sur rendez-vous</p>
        {telHref && <p><a href={telHref}>{salon.telephone}</a></p>}
      </div>
    </div>
  </footer>
</div>

<style is:global>
  /* ============ TOKENS ============ */
  :root {
    --bg: #ffffff;
    --cream: #f7f3ea;
    --cream-deep: #efe8d8;
    --ink: #26261f;
    --muted: #807f70;
    --olive: #6b6e4b;
    --olive-deep: #4b4e34;
    --espresso: #2a231d;
    --terracotta: #bd6a4c;    /* ACTIONS ONLY */
    --terracotta-deep: #a5573b;
    --line: rgba(38, 38, 31, 0.10);
    --line-light: rgba(247, 243, 234, 0.18);
    --serif: "Fraunces", Georgia, "Times New Roman", serif;
    --sans: "Poppins", -apple-system, system-ui, sans-serif;
    --maxw: 1200px;
    --gutter: clamp(1.25rem, 5vw, 4.5rem);
    --section-y: clamp(4rem, 8vw, 7rem);
    --radius: 2px;
    --ease: cubic-bezier(.2, .7, .2, 1);
  }

  /* ============ BASE ============ */
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; overflow-x: hidden;
    background: var(--bg); color: var(--ink);
    font-family: var(--sans); font-weight: 300;
    font-size: clamp(1rem, 0.96rem + 0.3vw, 1.0625rem);
    line-height: 1.75; letter-spacing: 0.01em;
    -webkit-font-smoothing: antialiased;
  }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  h1, h2 { margin: 0; font-weight: 400; }
  ul { margin: 0; padding: 0; list-style: none; }

  /* ============ TYPE ============ */
  .editorial {
    font-family: var(--serif); font-weight: 340; font-optical-sizing: auto;
    font-size: clamp(2.6rem, 1.5rem + 5.4vw, 5rem);
    line-height: 1.0; letter-spacing: -0.02em; color: var(--ink); margin: 0;
  }
  .h-seo {
    font-family: var(--serif); font-weight: 400;
    font-size: clamp(1.35rem, 1.15rem + 0.9vw, 1.85rem);
    line-height: 1.25; letter-spacing: -0.005em; color: var(--ink);
    max-width: 22ch; margin: 0;
  }
  .ital { font-style: italic; font-weight: 330; color: var(--olive); }
  .label {
    font-family: var(--sans); font-weight: 600;
    font-size: 0.7rem; letter-spacing: 0.26em; text-transform: uppercase;
    color: var(--olive); margin: 0 0 1.1rem;
  }
  .label-light { color: #d8c9a8; }
  .lede {
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.25rem); line-height: 1.6;
    color: var(--ink); max-width: 36ch; margin: 1.4rem 0 0; font-weight: 300;
  }
  .body { color: var(--ink); max-width: 44ch; margin: 1.25rem 0 1.75rem; }
  .body-light { color: rgba(247, 243, 234, 0.82); }

  /* richtext / texte enrichi : neutralise les marges des paragraphes */
  .rt > :first-child { margin-top: 0; }
  .rt > :last-child { margin-bottom: 0; }
  .rt p { margin: 0 0 1rem; }
  .rt a { color: var(--olive); text-decoration: underline; text-underline-offset: 3px; }

  /* ============ LAYOUT ============ */
  .section { max-width: var(--maxw); margin-inline: auto; padding: var(--section-y) var(--gutter); }
  .section-head { margin-bottom: clamp(2rem, 5vw, 3.5rem); }

  /* ============ HEADER ============ */
  .site-header {
    position: sticky; top: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.1rem var(--gutter);
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .wordmark { font-family: var(--serif); font-size: 1.18rem; text-decoration: none; color: var(--ink); line-height: 1; }
  .wordmark-sub { font-family: var(--sans); font-weight: 500; font-size: 0.6rem; letter-spacing: 0.26em; text-transform: uppercase; color: var(--olive); display: block; margin-top: 0.35rem; }

  /* ============ BUTTONS / LINKS ============ */
  .btn {
    --pad-y: 0.95rem; --pad-x: 1.9rem;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--sans); font-weight: 500; font-size: 0.82rem;
    letter-spacing: 0.08em; text-transform: uppercase;
    padding: var(--pad-y) var(--pad-x); border-radius: var(--radius);
    text-decoration: none; cursor: pointer; border: 1px solid transparent;
    transition: transform 0.45s var(--ease), background-color 0.45s, color 0.45s, box-shadow 0.45s, border-color 0.45s;
  }
  .btn-action { background: var(--terracotta); color: #fff; }
  .btn-action:hover { background: var(--terracotta-deep); transform: translateY(-2px); box-shadow: 0 14px 30px -14px rgba(165, 87, 59, 0.6); }
  .btn-ghost { background: transparent; color: var(--ink); border-color: var(--line); }
  .btn-ghost:hover { border-color: var(--olive); color: var(--olive); }
  .btn-sm { --pad-y: 0.7rem; --pad-x: 1.3rem; font-size: 0.72rem; }
  .btn-lg { --pad-y: 1.15rem; --pad-x: 2.6rem; font-size: 0.86rem; }

  .link-olive, .link-cream {
    font-family: var(--sans); font-weight: 500; font-size: 0.92rem;
    text-decoration: none; border-bottom: 1px solid transparent; padding-bottom: 2px;
    transition: border-color 0.4s, letter-spacing 0.4s;
  }
  .link-olive { color: var(--olive); }
  .link-olive:hover { border-color: var(--olive); letter-spacing: 0.03em; }
  .link-cream { color: var(--cream); }
  .link-cream:hover { border-color: var(--cream); letter-spacing: 0.03em; }

  /* ============ FRAMES (images) ============ */
  .frame {
    position: relative; width: 100%; aspect-ratio: 4 / 3;
    border-radius: var(--radius); overflow: hidden;
    background:
      radial-gradient(120% 90% at 78% 12%, rgba(255,255,255,0.55), transparent 55%),
      radial-gradient(130% 120% at 15% 95%, var(--olive) 0%, transparent 60%),
      linear-gradient(150deg, var(--cream) 0%, var(--cream-deep) 55%, #d9d4bf 100%);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: transform 0.9s var(--ease);
  }
  .frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .frame-tall { aspect-ratio: 4 / 5; }
  .frame-wide { aspect-ratio: 3 / 2; }
  .hero-visual:hover .frame,
  .split-visual:hover .frame { transform: scale(1.015); }

  /* ============ 1. HERO ============ */
  .hero {
    max-width: var(--maxw); margin-inline: auto;
    padding: clamp(2rem, 6vw, 3.5rem) var(--gutter) var(--section-y);
    display: grid; gap: clamp(2.25rem, 6vw, 3.5rem);
  }
  .hero-copy { align-self: center; }
  .hero-editorial { margin-bottom: 1.6rem; }
  .hero-h1 { color: var(--muted); font-weight: 380; max-width: 26ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2.5rem; }

  /* ============ 2. NAP ============ */
  .nap-wrap { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .nap { max-width: var(--maxw); margin-inline: auto; padding: var(--section-y) var(--gutter); display: grid; gap: clamp(2rem, 5vw, 3rem); }
  .nap-line { margin: 0.15rem 0; font-size: 1.06rem; }
  .hours li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid var(--line); font-size: 0.98rem; }
  .hours li:last-child { border-bottom: 0; }
  .hours .is-closed { color: var(--muted); }
  .phone { display: inline-block; margin: 0.3rem 0 1.3rem; font-family: var(--serif); font-size: 1.5rem; color: var(--ink); text-decoration: none; }
  .nap-cta { display: inline-flex; }

  /* ============ 3 & 5. SPLIT ============ */
  .split { max-width: var(--maxw); margin-inline: auto; padding: var(--section-y) var(--gutter); display: grid; gap: clamp(2rem, 5vw, 3.5rem); align-items: center; }
  .split-copy { align-self: center; }

  /* ============ SERVICE SOMBRE (plein cadre, esprit cocon) ============ */
  .service-dark { background: var(--espresso); color: var(--cream); }
  .service-dark .h-seo { color: rgba(247, 243, 234, 0.92); }
  .service-dark .body { color: rgba(247, 243, 234, 0.82); }
  .frame-dark {
    background:
      radial-gradient(120% 90% at 80% 10%, rgba(189, 106, 76, 0.28), transparent 55%),
      linear-gradient(150deg, #3a302a 0%, #2a231d 60%, #1d1813 100%);
    box-shadow: inset 0 0 0 1px var(--line-light);
  }

  /* ============ 4. INTRO LOCALE ============ */
  .intro-locale { max-width: var(--maxw); margin-inline: auto; padding: var(--section-y) var(--gutter); }
  .intro-text {
    font-family: var(--serif); font-weight: 340;
    font-size: clamp(1.5rem, 1rem + 2.4vw, 2.4rem); line-height: 1.4;
    letter-spacing: -0.01em; color: var(--ink); margin: 0; max-width: 20ch;
  }

  /* ============ FAQ ============ */
  .faq-list { border-top: 1px solid var(--line); max-width: 820px; }
  .faq-item { border-bottom: 1px solid var(--line); }
  .faq-item summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.4rem 0; cursor: pointer; list-style: none; font-family: var(--serif); font-size: clamp(1.1rem, 1rem + 0.6vw, 1.3rem); color: var(--ink); }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-plus { position: relative; width: 16px; height: 16px; flex: none; }
  .faq-plus::before, .faq-plus::after { content: ""; position: absolute; background: var(--olive); transition: transform 0.4s var(--ease); }
  .faq-plus::before { top: 7px; left: 0; width: 16px; height: 1.5px; }
  .faq-plus::after { left: 7px; top: 0; width: 1.5px; height: 16px; }
  .faq-item[open] .faq-plus::after { transform: scaleY(0); }
  .faq-item .rt { margin: 0 0 1.5rem; max-width: 62ch; color: var(--ink); }

  /* ============ CTA ============ */
  .cta-inner { background: var(--olive); color: #fff; border-radius: var(--radius); padding: clamp(3rem, 8vw, 6rem) var(--gutter); }
  .cta-title { color: #fff; }
  .cta-title .ital { color: var(--cream); }
  .cta-lede { color: rgba(255,255,255,0.86); }
  .cta .btn-action { margin-top: 2.4rem; }
  .cta-phone { margin: 1.4rem 0 0; font-size: 0.9rem; color: rgba(255,255,255,0.8); }
  .cta-phone a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }

  /* ============ ÉQUIPE (grands portraits ronds) ============ */
  .team-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(2rem, 6vw, 3rem) clamp(1.5rem, 4vw, 2.5rem); }
  .team-card { text-align: center; }
  .avatar {
    width: clamp(150px, 42vw, 200px); aspect-ratio: 1; margin: 0 auto 1.1rem;
    border-radius: 50%; overflow: hidden; position: relative;
    background: linear-gradient(150deg, var(--cream), var(--cream-deep));
    box-shadow: inset 0 0 0 1px var(--line);
    transition: transform 0.5s var(--ease);
  }
  .team-card:hover .avatar { transform: translateY(-4px); }
  .avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .avatar-initial { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--serif); font-size: clamp(2.4rem, 8vw, 3.4rem); color: var(--olive); }
  .team-name { font-family: var(--serif); font-size: 1.3rem; margin: 0 0 0.2rem; }
  .team-role { font-size: 0.88rem; color: var(--muted); margin: 0; letter-spacing: 0.02em; }

  /* ============ FOOTER ============ */
  .site-footer { max-width: var(--maxw); margin-inline: auto; padding: clamp(3rem, 6vw, 4.5rem) var(--gutter) 3rem; border-top: 1px solid var(--line); }
  .footer-grid { display: grid; gap: 2rem; }
  .footer-mark { font-family: var(--serif); font-size: 1.4rem; margin: 0; }
  .footer-sub { font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--olive); margin: 0.4rem 0 0; }
  .footer-meta p { margin: 0.25rem 0; font-size: 0.92rem; color: var(--muted); }
  .footer-meta a { color: var(--ink); text-decoration: none; }

  /* ============ MOTION (scroll reveal) ============ */
  .js .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.9s var(--ease), transform 0.9s var(--ease); will-change: opacity, transform; }
  .js .reveal.is-in { opacity: 1; transform: none; }
  .js .reveal[data-d="1"].is-in { transition-delay: 0.09s; }
  .js .reveal[data-d="2"].is-in { transition-delay: 0.18s; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .js .reveal { opacity: 1; transform: none; transition: none; }
  }

  /* ============ RESPONSIVE ≥ 820px ============ */
  @media (min-width: 820px) {
    .hero {
      grid-template-columns: 0.84fr 1.16fr; align-items: stretch;
      min-height: calc(100svh - 64px); gap: clamp(2.5rem, 5vw, 5rem);
      padding-top: clamp(2rem, 4vw, 3.5rem); padding-bottom: clamp(3rem, 6vw, 5rem);
    }
