{
  "name": "membre_equipe",
  "display_name": "Membre de l'équipe",
  "description": "Fiche d'un coiffeur / collaborateur. Une story par membre (URL /equipe/{slug}). Le slug est géré nativement par la story, pas un champ ici.",
  "is_root": true,
  "is_nestable": false,
  "schema": {
    "prenom": {
      "type": "text",
      "pos": 0,
      "display_name": "Prénom",
      "description": "Prénom affiché (ex. Camille)"
    },
    "salon": {
      "type": "option",
      "source": "internal_stories",
      "filter_content_type": "salon",
      "pos": 1,
      "display_name": "Salon de rattachement",
      "description": "Le salon où travaille ce membre. Sert à l'affichage AUTOMATIQUE de l'équipe sur la page salon."
    },
    "specialite": {
      "type": "text",
      "pos": 2,
      "display_name": "Spécialité",
      "description": "Ex. Coloriste, Visagiste, Barbier"
    },
    "citation": {
      "type": "textarea",
      "pos": 3,
      "display_name": "Citation",
      "description": "Une phrase personnelle, ton du salon."
    },
    "photo": {
      "type": "asset",
      "filetypes": ["images"],
      "pos": 4,
      "display_name": "Photo"
    },
    "bio": {
      "type": "richtext",
      "pos": 5,
      "display_name": "Bio",
      "description": "Parcours, approche. Texte riche."
    },
    "seo": {
      "type": "bloks",
      "pos": 6,
      "display_name": "SEO",
      "description": "Title / meta description / image de partage, propres à cette fiche.",
      "restrict_components": true,
      "component_whitelist": ["seo"],
      "maximum": 1
    }
  }
}
