# Variables d'environnement — copier en .env (NON versionné) et remplir.

# Avis Google (récupérés au build). Clé serveur, NE PAS exposer publiquement.
GOOGLE_PLACES_API_KEY=

# Google Tag Manager — conteneur unique qui gère GA4, Google Ads, Meta Pixel et
# TikTok Pixel. Laisser VIDE = aucune couche tracking chargée (inerte).
# Préfixe PUBLIC_ = injecté côté client par Astro. Format : GTM-XXXXXXX
PUBLIC_GTM_ID=

# Rappel : les IDs GA4 (G-...), Google Ads, Meta Pixel et TikTok Pixel ne se
# mettent PAS ici — ils se configurent DANS l'interface GTM (avec déclencheurs
# de consentement). Seul l'ID du conteneur GTM est nécessaire côté code.
