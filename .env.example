# Copier ce fichier en `.env` et renseigner les valeurs réelles.
# `.env` est gitignoré — ne jamais commiter de token.

# Token "Preview" de l'espace Storyblok (Settings → Access Tokens).
# Donne accès en lecture au contenu brouillon, utilisé au build.
STORYBLOK_TOKEN=

# Personal Access Token (My account → Personal access tokens) — Management API.
# Sert à la sync des composants (scripts/storyblok-sync.mjs). NE PAS commiter.
# Scopes : users:read + Components + Stories, sans restriction d'espace.
STORYBLOK_PAT=

# ID de l'espace Storyblok edm-site (Management API).
STORYBLOK_SPACE_ID=292922076607636
